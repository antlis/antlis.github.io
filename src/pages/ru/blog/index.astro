---
import Layout from '/src/layouts/Layout.astro'
import Card from '/src/components/Card.astro'
import { getCollection } from 'astro:content'
import { t, localePath } from '/src/i18n/utils'

const locale = 'ru'
const i = t(locale)
const posts = await getCollection('blog', ({ data }) => data.locale === 'ru')
---

<Layout title={i.blog.title}>
  <div class="blog-page">
    <h1>{i.blog.heading}</h1>

    <div class="post-list">
      {posts
        .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
        .map((post) => (
          <Card
            title={post.data.title}
            description={post.data.description}
            href={localePath(`/blog/${post.slug}`, locale)}
          />
        ))}
    </div>

    {posts.length === 0 && <p class="empty">{i.blog.empty}</p>}
  </div>
</Layout>

<style>
  .blog-page {
    padding-top: 2rem;
  }

  .blog-page h1 {
    margin: 0 0 1.5rem;
  }

  .post-list {
    display: grid;
    gap: 0.75rem;
  }

  .empty {
    color: var(--text-secondary);
  }
</style>
