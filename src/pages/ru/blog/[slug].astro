---
import Layout from '/src/layouts/Layout.astro'
import Comments from '/src/components/Comments.astro'
import { CldImage } from 'astro-cloudinary'
import { getCollection, getEntryBySlug } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => data.locale === 'ru')

  return posts.map((post) => ({
    params: { slug: post.slug },
  }))
}

const { slug } = Astro.params
const post = await getEntryBySlug('blog', slug)

if (!post) {
  throw new Error(`Post not found: ${slug}`)
}

const { Content } = await post.render()
---

<Layout title={`${post.data.title} — Блог`}>
  <article class="post">
    <h1>{post.data.title}</h1>
    <time>{post.data.pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
    {post.data.tags && post.data.tags.length > 0 && (
      <div class="tags">
        {post.data.tags.map((tag: string) => (
          <span class="tag">{tag}</span>
        ))}
      </div>
    )}
    {post.data.imgSrc && (
      <div class="hero-img">
        <CldImage
          src={post.data.imgSrc}
          alt={post.data.imgAlt || post.data.title}
          width={720}
          height={360}
          crop="fill"
          gravity="auto"
        />
      </div>
    )}
    <div class="content">
      <Content />
    </div>
    <Comments lang="ru" />
  </article>
</Layout>

<style>
  .post {
    max-width: 860px;
    padding-top: 2rem;
  }

  .hero-img {
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .hero-img :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .post h1 {
    margin-bottom: 0.5rem;
  }

  time {
    display: block;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: var(--card-hover);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .content {
    line-height: 1.8;
  }

  .content :global(p) {
    margin-bottom: 1.25rem;
  }

  .content :global(h2) {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .content :global(a) {
    color: var(--accent);
  }

  .content :global(a:hover) {
    color: var(--accent-hover);
  }

  .content :global(pre) {
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.25rem;
    border: 1px solid var(--border);
  }
</style>
