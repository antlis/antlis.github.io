---
import Layout from '/src/layouts/Layout.astro'
import { Icon } from 'astro-icon/components'
import { t } from '/src/i18n/utils'

const i = t('ru')
const platforms = [
  { name: 'GitHub', url: 'https://github.com/antlis', icon: 'simple-icons:github' },
  { name: 'LinkedIn', url: 'https://www.linkedin.com/in/antlis/', icon: 'simple-icons:linkedin' },
  { name: 'X', url: 'https://x.com/antlis5', icon: 'simple-icons:x' },
  { name: 'GitLab', url: 'https://gitlab.com/antlis', icon: 'simple-icons:gitlab' },
  { name: 'StackOverflow', url: 'https://stackoverflow.com/users/2983061/antlis', icon: 'simple-icons:stackoverflow' },
  { name: 'Telegram', url: 'https://t.me/Balkon1111', icon: 'simple-icons:telegram' },
]
---

<Layout title={i.contact.title} description={i.contact.description} pageType="contact">
  <section class="contact">
    <header class="contact-header">
      <h1>{i.contact.heading}</h1>
      <p>
        Быстрее всего связаться со мной через
        <a href="https://t.me/Balkon1111" target="_blank" rel="noopener">Telegram</a>.
        Можно также использовать форму ниже или найти меня на любой из этих платформ.
      </p>
    </header>

    <div class="platforms" aria-label="Социальные платформы">
      {platforms.map((platform) => (
        <a href={platform.url} target="_blank" rel="noopener">
          <Icon name={platform.icon} size="16" aria-hidden="true" />
          <span>{platform.name}</span>
        </a>
      ))}
    </div>

    <form class="contact-form" id="contact-form" novalidate>
      <input type="hidden" name="access_key" value="7f6f4055-477c-4f69-a865-4f241ae4e828" />
      <input type="hidden" name="subject" value="Новое сообщение с antlis.is-a.dev" />
      <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

      <div class="field">
        <label for="name">Имя</label>
        <input type="text" id="name" name="name" required placeholder="Ваше имя" aria-describedby="name-error" />
        <span class="error" id="name-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required placeholder="you@example.com" aria-describedby="email-error" />
        <span class="error" id="email-error" role="alert"></span>
      </div>

      <div class="field">
        <label for="message">Сообщение</label>
        <textarea id="message" name="message" required placeholder="Ваше сообщение..." rows="5" aria-describedby="message-error"></textarea>
        <span class="error" id="message-error" role="alert"></span>
      </div>

      <button type="submit">Отправить</button>
    </form>
  </section>
</Layout>

<script>
  function validateEmail(email: string) {
    return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)
  }

  function showSubmitError(form: HTMLFormElement, button: HTMLButtonElement, message: string) {
    button.disabled = false
    button.textContent = 'Отправить'
    let submitError = form.querySelector('.submit-error') as HTMLElement | null
    if (!submitError) {
      submitError = document.createElement('span')
      submitError.className = 'error submit-error'
      submitError.setAttribute('role', 'alert')
      form.querySelector('button')?.parentElement?.appendChild(submitError)
    }
    submitError.textContent = message
  }

  function validateField(input: HTMLInputElement | HTMLTextAreaElement) {
    const error = input.parentElement?.querySelector('.error') as HTMLElement
    if (!error) return true

    error.textContent = ''
    input.removeAttribute('aria-invalid')

    if (!input.value.trim()) {
      error.textContent = 'Обязательное поле'
      input.setAttribute('aria-invalid', 'true')
      return false
    }

    if (input.type === 'email' && !validateEmail(input.value)) {
      error.textContent = 'Введите корректный email'
      input.setAttribute('aria-invalid', 'true')
      return false
    }

    return true
  }

  function initForm() {
    const form = document.getElementById('contact-form') as HTMLFormElement | null
    if (!form) return
    if (form.dataset.formReady === 'true') return
    form.dataset.formReady = 'true'

    form.querySelectorAll('input:not([type="hidden"]):not([type="checkbox"]), textarea').forEach((input) => {
      input.addEventListener('blur', () => validateField(input as HTMLInputElement | HTMLTextAreaElement))
      input.addEventListener('input', () => {
        const error = input.parentElement?.querySelector('.error') as HTMLElement
        if (error?.textContent) validateField(input as HTMLInputElement | HTMLTextAreaElement)
      })
    })

    form.addEventListener('submit', async (e) => {
      e.preventDefault()

      const fields = form.querySelectorAll('input:not([type="hidden"]):not([type="checkbox"]), textarea')
      let valid = true
      fields.forEach((input) => {
        if (!validateField(input as HTMLInputElement | HTMLTextAreaElement)) valid = false
      })

      if (!valid) return

      const data = new FormData(form)
      const button = form.querySelector('button[type="submit"]') as HTMLButtonElement
      button.disabled = true
      button.textContent = 'Отправка...'

      try {
        const res = await fetch('https://api.web3forms.com/submit', {
          method: 'POST',
          body: data,
        })
        const json = await res.json()

        if (json.success) {
          form.innerHTML = '<p class="success">Сообщение отправлено! Скоро отвечу.</p>'
        } else {
          showSubmitError(form, button, 'Что-то пошло не так. Попробуйте ещё раз.')
        }
      } catch {
        showSubmitError(form, button, 'Не удалось связаться с сервером. Проверьте подключение и попробуйте снова.')
      }
    })
  }

  initForm()
  document.addEventListener('astro:after-swap', initForm)
</script>

<style>
  .contact {
    max-width: 720px;
    padding-top: 2rem;
  }

  .contact-header {
    margin-bottom: 1.5rem;
  }

  .contact h1 {
    margin-bottom: 0.9rem;
  }

  .contact-header p {
    max-width: 64ch;
    margin: 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1rem);
    line-height: 1.75;
  }

  .contact-header a {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
  }

  .contact-header a:hover {
    color: var(--accent-hover);
    text-decoration-color: var(--accent-hover);
  }

  .platforms {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .platforms a {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.38rem 0.72rem;
    color: var(--text-secondary);
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .platforms a:hover,
  .platforms a:focus-visible {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 40%, var(--border));
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.65rem;
    padding: 1.25rem;
    background: color-mix(in srgb, var(--card-bg) 88%, transparent);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    position: relative;
  }

  .field label {
    font-size: 0.85rem;
    font-weight: 500;
    color: var(--text);
  }

  .field input,
  .field textarea {
    padding: 0.65rem 0.85rem;
    font-size: 0.95rem;
    font-family: inherit;
    color: var(--text);
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 6px;
    outline: none;
    transition: border-color 0.2s;
  }

  .field input:focus,
  .field textarea:focus {
    border-color: var(--accent);
  }

  .field textarea {
    resize: vertical;
  }

  .error {
    min-height: 1rem;
    font-size: 0.75rem;
    color: var(--error);
  }

  button[type="submit"] {
    align-self: stretch;
    padding: 0.72rem 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    font-family: inherit;
    color: var(--bg);
    background: var(--text);
    border: 1px solid var(--text);
    border-radius: 6px;
    cursor: pointer;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  button[type="submit"]:hover:not(:disabled) {
    color: var(--bg);
    border-color: var(--accent);
    background: var(--accent);
  }

  button[type="submit"]:disabled {
    opacity: 0.5;
    cursor: not-allowed;
  }

  .success {
    text-align: center;
    color: var(--text-secondary);
    padding: 2rem 0;
  }
</style>
