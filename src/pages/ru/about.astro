---
import Layout from '/src/layouts/Layout.astro'
import { t } from '/src/i18n/utils'

const i = t('ru')
---

<Layout title={i.about.title}>
  <section class="about">
    <h1>{i.about.heading}</h1>
    <p>{i.about.text}</p>
  </section>
</Layout>

<style>
  .about {
    max-width: 640px;
    padding-top: 2rem;
  }

  .about h1 {
    margin-bottom: 1.5rem;
  }

  .about p {
    font-size: 1.1rem;
  }
</style>
