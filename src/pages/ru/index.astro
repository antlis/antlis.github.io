---
import Layout from '/src/layouts/Layout.astro'
import Card from '/src/components/Card.astro'
import GithubActivity from '/src/components/GithubActivity.astro'
import { getCollection } from 'astro:content'
import { t, localePath } from '/src/i18n/utils'

const locale = 'ru'
const i = t(locale)

const posts = await getCollection('blog', ({ data }) => data.locale === 'ru')
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3)
---

<Layout title={i.home.title} description={i.home.description} pageType="home">
  <section class="hero">
    <h1>{i.home.heading}</h1>
    <p>{i.home.description}</p>
  </section>

  {recentPosts.length > 0 && (
    <section>
      <div class="section-header">
        <h2>{i.home.recentPosts}</h2>
        <a href={localePath('/blog', locale)}>{i.home.viewAll}</a>
      </div>
      <div class="post-grid">
        {recentPosts.map((post) => (
          <Card
            title={post.data.title}
            description={post.data.description}
            href={localePath(`/blog/${post.slug}`, locale)}
            imgSrc={post.data.imgSrc}
            imgAlt={post.data.imgAlt}
            tags={post.data.tags}
          />
        ))}
      </div>
    </section>
  )}

  <GithubActivity />
</Layout>

<style>
  .hero {
    padding: 2rem 0 3rem;
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .hero p {
    max-width: 560px;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1rem);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .section-header a {
    font-size: 0.875rem;
    color: var(--accent);
    white-space: nowrap;
  }

  .section-header a:hover {
    color: var(--accent-hover);
  }

  .post-grid {
    display: grid;
    gap: 0.75rem;
  }
</style>
