---
import Layout from '/src/layouts/Layout.astro'
import BlogCard from '/src/components/BlogCard.astro'
import { getCollection } from 'astro:content'
import { t, localePath } from '/src/i18n/utils'

const locale = 'ru'
const i = t(locale)

const posts = await getCollection('blog', ({ data }) => data.locale === 'ru')
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3)
---

<Layout title={i.home.title} description={i.home.description} pageType="home">
  <section class="hero">
    <h1>{i.home.heading}</h1>
    <p>{i.home.description}</p>
  </section>

  {recentPosts.length > 0 && (
    <section class="recent-posts">
      <div class="section-header">
        <h2>{i.home.recentPosts}</h2>
        <a href={localePath('/blog', locale)}>{i.home.viewAll}</a>
      </div>
      <div class="post-grid">
        {recentPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={localePath(`/blog/${post.slug.replace(/-ru$/, '')}`, locale)}
            imgSrc={post.data.imgSrc}
            imgAlt={post.data.imgAlt}
            category={post.data.category}
            tags={post.data.tags}
            tagHrefBase={localePath('/blog', locale)}
            date={post.data.pubDate.toLocaleDateString('ru-RU', { year: 'numeric', month: 'long', day: 'numeric' })}
          />
        ))}
      </div>
    </section>
  )}

</Layout>

<style>
  .hero {
    padding: 2.75rem 0 3.75rem;
  }

  .hero h1 {
    max-width: 13ch;
    margin-bottom: 1rem;
    font-size: clamp(2.35rem, 1.7rem + 3vw, 4rem);
    line-height: 1.02;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }

  .hero p {
    max-width: 620px;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.15rem);
    line-height: 1.7;
  }

  .recent-posts {
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1.15rem;
    gap: 1rem;
  }

  .section-header h2 {
    letter-spacing: -0.01em;
  }

  .section-header a {
    font-size: 0.8rem;
    font-weight: 600;
    color: var(--text-secondary);
    white-space: nowrap;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .section-header a:hover {
    color: var(--text);
    border-color: var(--text-secondary);
    background: var(--card-hover);
  }

  .post-grid {
    display: grid;
    gap: 0.9rem;
  }
</style>
