---
import Layout from '/src/layouts/Layout.astro'
import { CldImage } from 'astro-cloudinary'
import { getCollection } from 'astro:content'
import { t, localePath } from '/src/i18n/utils'

const locale = 'ru'
const i = t(locale)
const projects = await getCollection('portfolio', ({ data }) => data.locale === 'ru')
projects.sort((a, b) => Number(b.data.year ?? 0) - Number(a.data.year ?? 0))
---

<Layout title={i.portfolio.title} description={i.portfolio.description} pageType="portfolio-listing">
  <section>
    <h1>{i.portfolio.heading}</h1>
    <p class="intro">{i.portfolio.intro}</p>

    <div class="grid">
      {projects.map(project => (
        <a
          href={localePath(`/portfolio/${project.slug.replace(/-ru$/, '')}`, locale)}
          class="project"
        >
          {project.data.imgSrc && (
            <div class="img-wrap">
              <CldImage
                src={project.data.imgSrc}
                alt={project.data.imgAlt || project.data.title}
                width={400}
                height={250}
              />
            </div>
          )}
          <div class="project-info">
            <div class="project-title">
              <h3>{project.data.title}</h3>
              {project.data.year && <span>{project.data.year}</span>}
            </div>
            <p>{project.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  h1 {
    margin-bottom: 0.85rem;
    padding-top: 2rem;
    letter-spacing: -0.025em;
  }

  .intro {
    max-width: 640px;
    margin-bottom: 2.25rem;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1rem);
    line-height: 1.75;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.1rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    overflow: hidden;
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .project:hover {
    background: color-mix(in srgb, var(--card-bg) 84%, var(--card-hover));
    border-color: color-mix(in srgb, var(--accent) 36%, var(--border));
    box-shadow: 0 14px 34px color-mix(in srgb, #000 8%, transparent);
    transform: translateY(-1px);
  }

  .img-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    color: transparent;
  }

  .project-info {
    padding: 1rem 1.25rem;
  }

  .project-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.4rem;
  }

  .project-title h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project-title span {
    flex: 0 0 auto;
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .project-info p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
