---
import Layout from '/src/layouts/Layout.astro'
import { CldImage } from 'astro-cloudinary'
import { getCollection } from 'astro:content'
import { t, localePath } from '/src/i18n/utils'

const locale = 'ru'
const i = t(locale)
const projects = await getCollection('portfolio', ({ data }) => data.locale === 'ru')
---

<Layout title={i.portfolio.title} description={i.portfolio.description}>
  <section>
    <h1>{i.portfolio.heading}</h1>

    <div class="grid">
      {projects.map(project => (
        <a
          href={project.data.href || localePath(`/portfolio/${project.slug}`, locale)}
          target={project.data.href ? "_blank" : undefined}
          rel={project.data.href ? "noopener" : undefined}
          class="project"
        >
          {project.data.imgSrc && (
            <div class="img-wrap">
              <CldImage
                src={project.data.imgSrc}
                alt={project.data.imgAlt || project.data.title}
                width={400}
                height={250}
              />
            </div>
          )}
          <div class="project-info">
            <h3>{project.data.title}</h3>
            <p>{project.data.description}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</Layout>

<style>
  h1 {
    margin-bottom: 1.5rem;
    padding-top: 2rem;
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    overflow: hidden;
    transition: background 0.2s, border-color 0.2s;
  }

  .project:hover {
    background: var(--card-hover);
    border-color: var(--text-secondary);
  }

  .img-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .project-info {
    padding: 1rem 1.25rem;
  }

  .project-info h3 {
    margin: 0 0 0.4rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .project-info p {
    margin: 0;
    font-size: 0.8rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  @media (max-width: 1100px) {
    .grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
