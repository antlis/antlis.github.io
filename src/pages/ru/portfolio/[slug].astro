---
import Layout from '/src/layouts/Layout.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'portfolio'>
}

export async function getStaticPaths() {
  const posts = await getCollection('portfolio', ({ data }) => data.locale === 'ru')

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const { Content } = await post.render()
---

<Layout title={`${post.data.title} — Портфолио`} description={post.data.description} image={post.data.imgSrc}>
  <article class="project">
    <h1>{post.data.title}</h1>
    {post.data.href && (
      <a href={post.data.href} target="_blank" rel="noopener" class="link">
        Перейти к проекту
      </a>
    )}
    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .project {
    max-width: 720px;
    padding-top: 2rem;
  }

  .project h1 {
    margin-bottom: 0.5rem;
  }

  .link {
    display: inline-block;
    font-size: 0.875rem;
    margin-bottom: 2rem;
    color: var(--accent);
  }

  .content {
    line-height: 1.8;
  }

  .content :global(p) {
    margin-bottom: 1.25rem;
  }
</style>
