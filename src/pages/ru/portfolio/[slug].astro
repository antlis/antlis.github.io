---
import PortfolioProject from '/src/components/PortfolioProject.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'

interface Props {
  post: CollectionEntry<'portfolio'>
}

export async function getStaticPaths() {
  const posts = await getCollection('portfolio', ({ data }) => data.locale === 'ru')

  return posts.map((post) => ({
    params: { slug: post.slug.replace(/-ru$/, '') },
    props: { post },
  }))
}

const { post } = Astro.props
const projects = await getCollection('portfolio', ({ data }) => data.locale === 'ru')
const { Content } = await post.render()
---

<PortfolioProject post={post} projects={projects} locale="ru">
  <Content />
</PortfolioProject>
