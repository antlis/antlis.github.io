---
import Layout from '/src/layouts/Layout.astro'
import HeroImage from '/src/components/HeroImage.astro'
import { getCollection } from 'astro:content'
import { t, localePath } from '/src/i18n/utils'

const locale = 'ru'
const i = t(locale)
const allProjects = await getCollection('projects', ({ data }) => data.locale === 'ru')

const projectItems = allProjects
  .filter(p => p.data.category === 'projects')
  .sort((a, b) => Number(b.data.year ?? 0) - Number(a.data.year ?? 0))

const portfolioItems = allProjects
  .filter(p => p.data.category === 'portfolio')
  .sort((a, b) => Number(b.data.year ?? 0) - Number(a.data.year ?? 0))
---

<Layout title={i.projects.title} description={i.projects.description} pageType="projects-listing">
  <section>
    <div class="intro-row">
      <div>
        <h1>{i.projects.heading}</h1>
        <p class="intro">{i.projects.intro}</p>
      </div>
      <div class="hero-placeholder">
        <svg width="100" height="100" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 3h6a4 4 0 0 1 4 4v14a3 3 0 0 0-3-3H2z"/>
          <path d="M22 3h-6a4 4 0 0 0-4 4v14a3 3 0 0 1 3-3h7z"/>
        </svg>
      </div>
    </div>

    {projectItems.length > 0 && (
      <div class="section">
        <div class="grid">
          {projectItems.map(project => (
            <a
              href={localePath(`/projects/${project.slug.replace(/-ru$/, '')}`, locale)}
              class="project"
            >
              {project.data.imgSrc && (
                <div class="img-wrap">
                  <HeroImage
                    src={project.data.imgSrc}
                    alt={project.data.imgAlt || project.data.title}
                    width={400}
                    height={250}
                  />
                </div>
              )}
              <div class="project-info">
                <div class="project-title">
                  <h3>{project.data.title}</h3>
                  {project.data.year && <span>{project.data.year}</span>}
                </div>
                <p>{project.data.description}</p>
                {project.data.stack && (
                  <div class="stack">
                    {project.data.stack.join(' · ')}
                  </div>
                )}
                <div class="links">
                  {project.data.href && (
                    <span class="link">GitHub ↗</span>
                  )}
                  {project.data.blogHref && (
                    <span class="link">Подробнее</span>
                  )}
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}

    {portfolioItems.length > 0 && (
      <div class="section">
        <h2>{i.projects.sections.portfolio.heading}</h2>
        <p class="section-intro">{i.projects.sections.portfolio.intro}</p>
        <div class="grid">
          {portfolioItems.map(project => (
            <a
              href={localePath(`/projects/${project.slug.replace(/-ru$/, '')}`, locale)}
              class="project"
            >
              {project.data.imgSrc && (
                <div class="img-wrap">
                  <HeroImage
                    src={project.data.imgSrc}
                    alt={project.data.imgAlt || project.data.title}
                    width={400}
                    height={250}
                  />
                </div>
              )}
              <div class="project-info">
                <div class="project-title">
                  <h3>{project.data.title}</h3>
                  {project.data.year && <span>{project.data.year}</span>}
                </div>
                <p>{project.data.description}</p>
              </div>
            </a>
          ))}
        </div>
      </div>
    )}
  </section>
</Layout>

<style>
  .intro-row {
    display: flex;
    align-items: center;
    gap: 2rem;
    margin-bottom: 2rem;
  }

  .intro-row > div:first-child {
    flex: 1 1 0;
    min-width: 0;
  }

  h1 {
    margin-bottom: 0.85rem;
    letter-spacing: -0.025em;
  }

  .intro {
    max-width: 640px;
    margin-bottom: 0;
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1rem);
    line-height: 1.75;
  }

  .hero-placeholder {
    flex: 0 0 40%;
    width: 40%;
    aspect-ratio: 16 / 10;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--card-bg);
    border: 2px dashed var(--border);
    border-radius: 10px;
    color: var(--text-secondary);
  }

  .section {
    margin-bottom: 3rem;
  }

  .section h2 {
    margin-bottom: 0.5rem;
    letter-spacing: -0.01em;
  }

  .section-intro {
    max-width: 640px;
    margin-bottom: 1.5rem;
    font-size: clamp(0.95rem, 0.9rem + 0.25vw, 1.05rem);
    line-height: 1.7;
    color: var(--text-secondary);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
    gap: 1.1rem;
  }

  .project {
    display: flex;
    flex-direction: column;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    overflow: hidden;
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .project:hover {
    background: color-mix(in srgb, var(--card-bg) 84%, var(--card-hover));
    border-color: color-mix(in srgb, var(--accent) 36%, var(--border));
    box-shadow: 0 14px 34px color-mix(in srgb, #000 8%, transparent);
    transform: translateY(-1px);
  }

  .img-wrap {
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
  }

  .img-wrap :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    color: transparent;
  }

  .project-info {
    padding: 1rem 1.25rem;
  }

  .project-title {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.75rem;
    margin: 0 0 0.4rem;
  }

  .project-title h3 {
    margin: 0;
    font-size: 1.02rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }

  .project-title span {
    flex: 0 0 auto;
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 650;
  }

  .project-info p {
    margin: 0;
    font-size: 0.86rem;
    line-height: 1.55;
    color: var(--text-secondary);
  }

  .stack {
    margin-top: 0.5rem;
    font-size: 0.78rem;
    color: var(--text-secondary);
    opacity: 0.8;
  }

  .links {
    display: flex;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }

  .link {
    font-size: 0.78rem;
    font-weight: 600;
    color: var(--accent);
  }

  @media (max-width: 640px) {
    .intro-row {
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
    }

    .hero-placeholder {
      flex: none;
      width: 100%;
    }
  }

  @media (max-width: 768px) {
    .grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 480px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
