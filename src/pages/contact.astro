---
import Layout from '/src/layouts/Layout.astro'
import Socials from '/src/components/Socials.astro'
import { t } from '/src/i18n/utils'

const i = t('en')
---

<Layout title={i.contact.title} description={i.contact.description}>
  <section class="contact">
    <h1>{i.contact.heading}</h1>
    <p>{i.contact.text}</p>

    <div class="contact-links">
      <a href="mailto:antlis@protonmail.com" class="email">antlis@protonmail.com</a>
      <Socials />
    </div>
  </section>
</Layout>

<style>
  .contact {
    max-width: 640px;
    padding-top: 2rem;
  }

  .contact h1 {
    margin-bottom: 1.5rem;
  }

  .contact p {
    font-size: 1.1rem;
    margin-bottom: 2rem;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .email {
    font-size: 1.1rem;
    font-weight: 500;
    color: var(--accent);
  }

  .email:hover {
    color: var(--accent-hover);
  }
</style>
