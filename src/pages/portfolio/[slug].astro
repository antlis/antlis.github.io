---
import Layout from '/src/layouts/Layout.astro'
import { getCollection, getEntryBySlug } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('portfolio', ({ data }) => (data.locale ?? 'en') === 'en')

  return posts.map((post) => ({
    params: { slug: post.slug },
  }))
}

const { slug } = Astro.params
const post = await getEntryBySlug('portfolio', slug)

if (!post) {
  throw new Error(`Project not found: ${slug}`)
}

const { Content } = await post.render()
---

<Layout title={`${post.data.title} — Portfolio`} description={post.data.description} image={post.data.imgSrc}>
  <article class="project">
    <h1>{post.data.title}</h1>
    {post.data.href && (
      <a href={post.data.href} target="_blank" rel="noopener" class="link">
        Visit project
      </a>
    )}
    <div class="content">
      <Content />
    </div>
  </article>
</Layout>

<style>
  .project {
    max-width: 720px;
    padding-top: 2rem;
  }

  .project h1 {
    margin-bottom: 0.5rem;
  }

  .link {
    display: inline-block;
    font-size: 0.875rem;
    margin-bottom: 2rem;
    color: var(--accent);
  }

  .content {
    line-height: 1.8;
  }

  .content :global(p) {
    margin-bottom: 1.25rem;
  }
</style>
