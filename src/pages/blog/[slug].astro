---
import Layout from '/src/layouts/Layout.astro'
import Comments from '/src/components/Comments.astro'
import BlogPostExtras from '/src/components/BlogPostExtras.astro'
import { getCollection } from 'astro:content'
import type { CollectionEntry } from 'astro:content'
import { localePath } from '/src/i18n/utils'
import 'medium-zoom/dist/style.css'

interface Props {
  post: CollectionEntry<'blog'>
}

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => (data.locale ?? 'en') === 'en')

  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }))
}

const { post } = Astro.props
const posts = await getCollection('blog', ({ data }) => (data.locale ?? 'en') === 'en')
const { Content, headings } = await post.render()
const tocHeadings = headings.filter((h: { depth: number }) => h.depth === 2)
---

<Layout title={`${post.data.title} | Antlis`} description={post.data.description} image={post.data.imgSrc} type="article" publishedTime={post.data.pubDate} modifiedTime={post.data.modifiedDate} pageType="blog-post" tags={post.data.tags}>
  <div class="post-layout">
    <article class="post">
      <h1>{post.data.title}</h1>
      <time><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag: string) => (
            <a class="tag" href={`${localePath('/blog', 'en')}?tag=${encodeURIComponent(tag)}`}>{tag}</a>
          ))}
        </div>
      )}
      {post.data.imgSrc && (
        <div class="hero-img">
          <img
            src={post.data.imgSrc}
            alt={post.data.imgAlt || post.data.title}
            width={1200}
            height={760}
            decoding="async"
          />
        </div>
      )}
      <div class="content">
        <Content />
      </div>
      <BlogPostExtras posts={posts} currentSlug={post.slug} locale="en" />
      <Comments lang="en" />
    </article>

    {tocHeadings.length > 1 && (
      <aside class="sidebar">
        <nav class="toc">
          <p class="toc-title">On this page</p>
          <ul>
            {tocHeadings.map((heading: { slug: string; text: string }) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
  <button class="back-to-top" type="button" aria-label="Back to top" hidden>
    <svg aria-hidden="true" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.25" stroke-linecap="round" stroke-linejoin="round">
      <path d="m18 15-6-6-6 6"/>
    </svg>
  </button>
</Layout>

<script>
  let tocCleanup: (() => void) | undefined
  let backToTopCleanup: (() => void) | undefined

  function getTocTarget(hash: string | null): HTMLElement | null {
    if (!hash?.startsWith('#')) return null

    const id = hash.slice(1)
    if (!id) return null

    try {
      return document.getElementById(id) ?? document.getElementById(decodeURIComponent(id))
    } catch {
      return document.getElementById(id)
    }
  }

  function initToc() {
    tocCleanup?.()

    const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.toc a'))
    const tocItems = links
      .map((link) => ({
        link,
        target: getTocTarget(link.getAttribute('href')),
      }))
      .filter((item): item is { link: HTMLAnchorElement; target: HTMLElement } => item.target !== null)

    if (!tocItems.length) return

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let ticking = false

    function setActive(target: HTMLElement) {
      tocItems.forEach(({ link }) => {
        const isActive = target === getTocTarget(link.getAttribute('href'))
        link.classList.toggle('active', isActive)
        if (isActive) link.setAttribute('aria-current', 'true')
        else link.removeAttribute('aria-current')
      })
    }

    function updateActive() {
      ticking = false

      const current =
        tocItems
          .slice()
          .reverse()
          .find(({ target }) => target.getBoundingClientRect().top <= 120) ?? tocItems[0]

      setActive(current.target)
    }

    function requestUpdate() {
      if (ticking) return
      ticking = true
      requestAnimationFrame(updateActive)
    }

    tocItems.forEach(({ link, target }) => {
      link.addEventListener('click', (event) => {
        event.preventDefault()

        const top = target.getBoundingClientRect().top + window.scrollY - 24
        window.scrollTo({
          top,
          behavior: reduceMotion ? 'auto' : 'smooth',
        })
        history.pushState(null, '', link.getAttribute('href'))
        setActive(target)
      })
    })

    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate)
    updateActive()

    tocCleanup = () => {
      window.removeEventListener('scroll', requestUpdate)
      window.removeEventListener('resize', requestUpdate)
    }
  }

  initToc()
  document.addEventListener('astro:after-swap', initToc)

  function initBackToTop() {
    backToTopCleanup?.()

    const button = document.querySelector<HTMLButtonElement>('.back-to-top')
    if (!button) return
    const backToTopButton = button
    const footer = document.querySelector<HTMLElement>('body > footer')

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches
    let ticking = false

    function updateVisibility() {
      ticking = false

      const isLongArticle = document.documentElement.scrollHeight > window.innerHeight * 1.8
      const footerTop = footer?.getBoundingClientRect().top ?? Number.POSITIVE_INFINITY
      const footerOffset = Math.max(20, window.innerHeight - footerTop + 20)
      const shouldShow = isLongArticle && window.scrollY > window.innerHeight * 0.7

      backToTopButton.style.setProperty('--back-to-top-bottom', `${footerOffset}px`)
      backToTopButton.hidden = !isLongArticle
      backToTopButton.classList.toggle('visible', shouldShow)
    }

    function requestUpdate() {
      if (ticking) return
      ticking = true
      requestAnimationFrame(updateVisibility)
    }

    function scrollToTop() {
      window.scrollTo({
        top: 0,
        behavior: reduceMotion ? 'auto' : 'smooth',
      })
    }

    backToTopButton.addEventListener('click', scrollToTop)
    window.addEventListener('scroll', requestUpdate, { passive: true })
    window.addEventListener('resize', requestUpdate)
    updateVisibility()

    backToTopCleanup = () => {
      backToTopButton.removeEventListener('click', scrollToTop)
      window.removeEventListener('scroll', requestUpdate)
      window.removeEventListener('resize', requestUpdate)
    }
  }

  initBackToTop()
  document.addEventListener('astro:after-swap', initBackToTop)

  import mediumZoom from 'medium-zoom'

  function initZoom() {
    mediumZoom('.content img, .hero-img img', { margin: 24, background: 'rgba(0,0,0,0.85)' })
  }

  initZoom()
  document.addEventListener('astro:after-swap', initZoom)

  function initCodeA11y() {
    document.querySelectorAll<HTMLButtonElement>('.expressive-code .copy button').forEach((button) => {
      button.setAttribute('aria-label', 'Copy code')
    })
  }

  initCodeA11y()
  document.addEventListener('astro:after-swap', initCodeA11y)
</script>

<style>
  .post-layout {
    display: block;
  }

  .post-layout:has(.sidebar) {
    display: grid;
    grid-template-columns: minmax(0, 760px) 200px;
    gap: 3rem;
    justify-content: center;
  }

  .post {
    padding-top: 2rem;
    min-width: 0;
    max-width: 760px;
  }

  .sidebar {
    padding-top: 2rem;
  }

  .toc {
    position: sticky;
    top: 2rem;
  }

  .toc-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border);
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: color 0.2s, border-color 0.2s;
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc :global(a.active) {
    color: var(--accent);
    border-left-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    font-weight: 600;
  }

  .back-to-top {
    position: fixed;
    right: max(1rem, calc((100vw - 1100px) / 2));
    bottom: var(--back-to-top-bottom, 1.25rem);
    z-index: 30;
    display: inline-grid;
    place-items: center;
    width: 2.75rem;
    height: 2.75rem;
    color: var(--text);
    background: color-mix(in srgb, var(--card-bg) 92%, transparent);
    border: 1px solid var(--border);
    border-radius: 999px;
    box-shadow: 0 12px 34px color-mix(in srgb, #000 16%, transparent);
    opacity: 0;
    transform: translateY(0.5rem);
    pointer-events: none;
    cursor: pointer;
    transition:
      opacity 0.2s ease,
      transform 0.2s ease,
      border-color 0.2s ease,
      background 0.2s ease;
  }

  .back-to-top[hidden] {
    display: none;
  }

  .back-to-top.visible {
    opacity: 1;
    transform: translateY(0);
    pointer-events: auto;
  }

  .back-to-top:hover,
  .back-to-top:focus-visible {
    color: var(--accent);
    background: var(--card-bg);
    border-color: var(--accent);
  }

  .back-to-top:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 3px;
  }

  @media (max-width: 768px) {
    .post-layout,
    .post-layout:has(.sidebar) {
      display: block;
      grid-template-columns: 1fr;
      width: 100%;
    }

    .post {
      width: 100%;
      max-width: none;
    }

    .sidebar {
      display: none;
    }

    .back-to-top {
      right: 1rem;
      bottom: 1rem;
      width: 2.5rem;
      height: 2.5rem;
    }
  }

  .hero-img {
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .hero-img :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .post h1 {
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  time svg {
    flex-shrink: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: var(--card-hover);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration: none;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .tag:hover,
  .tag:focus-visible {
    color: var(--text);
    border-color: var(--text-secondary);
    background: var(--card-bg);
  }

  .content {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.0625rem);
    line-height: 1.78;
  }

  .content :global(> p:first-child) {
    color: var(--text);
    font-size: clamp(1.08rem, 1rem + 0.35vw, 1.18rem);
    line-height: 1.72;
  }

  .content :global(p) {
    margin-bottom: 1.5em;
  }

  .content :global(h2) {
    margin-top: 2.75em;
    margin-bottom: 0.75em;
    letter-spacing: -0.01em;
    scroll-margin-top: 2rem;
  }

  .content :global(h3) {
    margin-top: 2em;
    margin-bottom: 0.5em;
    scroll-margin-top: 2rem;
  }

  .content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s;
  }

  .content :global(a:hover) {
    color: var(--accent-hover);
    text-decoration-color: var(--accent-hover);
  }

  .content :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.75em 1.25em;
    border-left: 3px solid var(--accent);
    background: var(--card-hover);
    border-radius: 0 6px 6px 0;
  }

  .content :global(blockquote p) {
    margin-bottom: 0.5em;
    color: var(--text-secondary);
    font-style: italic;
  }

  .content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .content :global(.article-photo) {
    margin: 1.75rem 0 2rem;
  }

  .content :global(.article-photo img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .content :global(.medium-zoom-image),
  .hero-img :global(.medium-zoom-image) {
    cursor: pointer !important;
  }

  :global(.medium-zoom-overlay) {
    z-index: 1000;
  }
  :global(.medium-zoom-image--opened) {
    z-index: 1001;
    position: relative;
  }

  .content :global(.article-photo figcaption) {
    margin-top: 0.55rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .content :global(.architecture-diagram) {
    margin: 1.75rem 0 2rem;
  }

  .content :global(.architecture-diagram img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: #0f172a;
  }

  .content :global(.architecture-diagram figcaption) {
    margin-top: 0.55rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .content :global(.spec-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.75rem 0 2rem;
  }

  .content :global(.spec-item) {
    min-width: 0;
    padding: 0.9rem 1rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .content :global(.spec-item span) {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .content :global(.spec-item strong) {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 1rem;
    line-height: 1.35;
  }

  .content :global(.spec-item small) {
    display: block;
    color: var(--text-secondary);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .content :global(.spec-item code) {
    font-size: 0.78rem;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: 1.5em;
    padding-left: 1.5em;
  }

  .content :global(li) {
    margin-bottom: 0.5em;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .content :global(li strong) {
    color: var(--text);
  }

  .content :global(ol) {
    list-style-type: decimal;
  }

  .content :global(ul) {
    list-style-type: disc;
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5em 0;
  }

  .content :global(pre) {
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.5em;
    border: 1px solid var(--border);
    font-size: 0.875em;
  }

  @media (max-width: 768px) {
    .post h1 {
      line-height: 1.25;
    }

    .content :global(blockquote) {
      padding: 0.625em 1em;
      margin-left: 0;
      margin-right: 0;
    }

    .content :global(pre) {
      max-width: 100%;
      border-radius: 8px;
      margin-left: 0;
      margin-right: 0;
      padding: 1rem;
    }

    .content :global(.expressive-code),
    .content :global(.expressive-code .frame) {
      max-width: 100%;
      min-width: 0;
      overflow-x: auto;
    }

    .content :global(.expressive-code pre) {
      max-width: 100%;
      min-width: 0;
      overflow-x: auto;
    }

    .content :global(.expressive-code .copy) {
      right: 0.5rem;
    }

    .content :global(.spec-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
