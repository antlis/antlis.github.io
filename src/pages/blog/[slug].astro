---
import Layout from '/src/layouts/Layout.astro'
import Comments from '/src/components/Comments.astro'
import { getCollection, getEntryBySlug } from 'astro:content'

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => (data.locale ?? 'en') === 'en')

  return posts.map((post) => ({
    params: { slug: post.slug },
  }))
}

const { slug } = Astro.params
const post = await getEntryBySlug('blog', slug)

if (!post) {
  throw new Error(`Post not found: ${slug}`)
}

const { Content, headings } = await post.render()
const tocHeadings = headings.filter((h) => h.depth === 2)
---

<Layout title={`${post.data.title} | Antlis`} description={post.data.description} image={post.data.imgSrc} type="article" publishedTime={post.data.pubDate} modifiedTime={post.data.modifiedDate} pageType="blog-post" tags={post.data.tags}>
  <div class="post-layout">
    <article class="post">
      <h1>{post.data.title}</h1>
      <time><svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>{post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}</time>
      {post.data.tags && post.data.tags.length > 0 && (
        <div class="tags">
          {post.data.tags.map((tag: string) => (
            <span class="tag">{tag}</span>
          ))}
        </div>
      )}
      {post.data.imgSrc && (
        <div class="hero-img">
          <img
            src={post.data.imgSrc}
            alt={post.data.imgAlt || post.data.title}
            width={1200}
            height={760}
            decoding="async"
          />
        </div>
      )}
      <div class="content">
        <Content />
      </div>
      <Comments lang="en" />
    </article>

    {tocHeadings.length > 1 && (
      <aside class="sidebar">
        <nav class="toc">
          <p class="toc-title">On this page</p>
          <ul>
            {tocHeadings.map((heading) => (
              <li>
                <a href={`#${heading.slug}`}>{heading.text}</a>
              </li>
            ))}
          </ul>
        </nav>
      </aside>
    )}
  </div>
</Layout>

<script>
  function initToc() {
    const links = document.querySelectorAll('.toc a')
    const headings = document.querySelectorAll('.content h2')
    if (!links.length || !headings.length) return

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            links.forEach((link) => link.classList.remove('active'))
            const active = document.querySelector(`.toc a[href="#${entry.target.id}"]`)
            active?.classList.add('active')
          }
        })
      },
      { rootMargin: '0px 0px -70% 0px', threshold: 0 }
    )

    headings.forEach((h) => observer.observe(h))
  }

  initToc()
  document.addEventListener('astro:after-swap', initToc)
</script>

<style>
  .post-layout {
    display: grid;
    grid-template-columns: 1fr 200px;
    gap: 3rem;
  }

  .post {
    padding-top: 2rem;
    min-width: 0;
  }

  .sidebar {
    padding-top: 2rem;
  }

  .toc {
    position: sticky;
    top: 2rem;
  }

  .toc-title {
    font-size: 0.75rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  .toc ul {
    list-style: none;
    padding: 0;
    margin: 0;
    border-left: 1px solid var(--border);
  }

  .toc li {
    margin: 0;
  }

  .toc a {
    display: block;
    padding: 0.3rem 0 0.3rem 0.875rem;
    font-size: 0.8125rem;
    line-height: 1.4;
    color: var(--text-secondary);
    border-left: 2px solid transparent;
    margin-left: -1px;
    transition: color 0.2s, border-color 0.2s;
  }

  .toc a:hover {
    color: var(--text);
  }

  .toc a:global(.active) {
    color: var(--accent);
    border-left-color: var(--accent);
  }

  @media (max-width: 768px) {
    .post-layout {
      grid-template-columns: 1fr;
    }

    .sidebar {
      display: none;
    }
  }

  .hero-img {
    border-radius: 10px;
    overflow: hidden;
    margin-bottom: 1.5rem;
  }

  .hero-img :global(img) {
    width: 100%;
    height: auto;
    display: block;
  }

  .post h1 {
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  time {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.875rem;
    color: var(--text-secondary);
    margin-bottom: 0.75rem;
  }

  time svg {
    flex-shrink: 0;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 2rem;
  }

  .tag {
    font-size: 0.75rem;
    padding: 0.2rem 0.6rem;
    background: var(--card-hover);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .content {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.0625rem);
    line-height: 1.75;
  }

  .content :global(p) {
    margin-bottom: 1.5em;
  }

  .content :global(h2) {
    margin-top: 2.5em;
    margin-bottom: 0.75em;
    letter-spacing: -0.01em;
  }

  .content :global(h3) {
    margin-top: 2em;
    margin-bottom: 0.5em;
  }

  .content :global(strong) {
    color: var(--text);
    font-weight: 600;
  }

  .content :global(a) {
    color: var(--accent);
    text-decoration: underline;
    text-decoration-color: color-mix(in srgb, var(--accent) 40%, transparent);
    text-underline-offset: 2px;
    transition: text-decoration-color 0.2s;
  }

  .content :global(a:hover) {
    color: var(--accent-hover);
    text-decoration-color: var(--accent-hover);
  }

  .content :global(blockquote) {
    margin: 1.5em 0;
    padding: 0.75em 1.25em;
    border-left: 3px solid var(--accent);
    background: var(--card-hover);
    border-radius: 0 6px 6px 0;
  }

  .content :global(blockquote p) {
    margin-bottom: 0.5em;
    color: var(--text-secondary);
    font-style: italic;
  }

  .content :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .content :global(.article-photo) {
    margin: 1.75rem 0 2rem;
  }

  .content :global(.article-photo img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 8px;
    border: 1px solid var(--border);
  }

  .content :global(.article-photo figcaption) {
    margin-top: 0.55rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .content :global(.architecture-diagram) {
    margin: 1.75rem 0 2rem;
  }

  .content :global(.architecture-diagram img) {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 10px;
    border: 1px solid var(--border);
    background: #0f172a;
  }

  .content :global(.architecture-diagram figcaption) {
    margin-top: 0.55rem;
    color: var(--text-secondary);
    font-size: 0.85rem;
    line-height: 1.5;
  }

  .content :global(.spec-grid) {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.75rem;
    margin: 1.75rem 0 2rem;
  }

  .content :global(.spec-item) {
    min-width: 0;
    padding: 0.9rem 1rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .content :global(.spec-item span) {
    display: block;
    margin-bottom: 0.35rem;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--text-secondary);
  }

  .content :global(.spec-item strong) {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 1rem;
    line-height: 1.35;
  }

  .content :global(.spec-item small) {
    display: block;
    color: var(--text-secondary);
    font-size: 0.84rem;
    line-height: 1.5;
  }

  .content :global(.spec-item code) {
    font-size: 0.78rem;
  }

  .content :global(ul),
  .content :global(ol) {
    margin-bottom: 1.5em;
    padding-left: 1.5em;
  }

  .content :global(li) {
    margin-bottom: 0.5em;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  .content :global(li strong) {
    color: var(--text);
  }

  .content :global(ol) {
    list-style-type: decimal;
  }

  .content :global(ul) {
    list-style-type: disc;
  }

  .content :global(hr) {
    border: none;
    border-top: 1px solid var(--border);
    margin: 2.5em 0;
  }

  .content :global(pre) {
    padding: 1rem;
    border-radius: 8px;
    overflow-x: auto;
    margin-bottom: 1.5em;
    border: 1px solid var(--border);
    font-size: 0.875em;
  }

  @media (max-width: 768px) {
    .post h1 {
      line-height: 1.25;
    }

    .content :global(blockquote) {
      padding: 0.625em 1em;
      margin-left: 0;
      margin-right: 0;
    }

    .content :global(pre) {
      border-radius: 0;
      margin-left: calc(-1 * clamp(1rem, 3vw, 2rem));
      margin-right: calc(-1 * clamp(1rem, 3vw, 2rem));
      padding: 1rem clamp(1rem, 3vw, 2rem);
    }

    .content :global(.spec-grid) {
      grid-template-columns: 1fr;
    }
  }
</style>
