---
import Layout from '/src/layouts/Layout.astro'
import Card from '/src/components/Card.astro'
import { getCollection } from 'astro:content'
import { t, localePath } from '/src/i18n/utils'

const locale = 'en'
const i = t(locale)
const posts = await getCollection('blog', ({ data }) => (data.locale ?? 'en') === 'en')
const sortedPosts = posts.sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
const allTags = [...new Set(sortedPosts.flatMap((p) => p.data.tags || []))].sort()
---

<Layout title={i.blog.title} description={i.blog.description} pageType="blog-listing">
  <div class="blog-page">
    <h1>{i.blog.heading}</h1>

    {allTags.length > 0 && (
      <div class="tag-filter">
        <button class="filter-tag active" data-tag="all">All</button>
        {allTags.map((tag) => (
          <button class="filter-tag" data-tag={tag}>{tag}</button>
        ))}
      </div>
    )}

    <div class="post-list">
      {sortedPosts.map((post) => (
        <Card
          title={post.data.title}
          description={post.data.description}
          href={localePath(`/blog/${post.slug}`, locale)}
          tags={post.data.tags}
          imgSrc={post.data.imgSrc}
          imgAlt={post.data.imgAlt}
          date={post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
        />
      ))}
    </div>

    {posts.length === 0 && <p class="empty">{i.blog.empty}</p>}
  </div>
</Layout>

<style>
  .blog-page {
    padding-top: 2rem;
  }

  @media (max-width: 640px) {
    .blog-page {
      padding-top: 1rem;
    }
  }

  .blog-page h1 {
    margin: 0 0 1.5rem;
  }

  .tag-filter {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .filter-tag {
    font-size: 0.75rem;
    padding: 0.25rem 0.7rem;
    background: var(--card-bg);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    cursor: pointer;
    font-family: inherit;
    transition: all 0.2s;
  }

  .filter-tag:hover {
    border-color: var(--text-secondary);
    color: var(--text);
  }

  .filter-tag.active {
    background: var(--text);
    color: var(--bg);
    border-color: var(--text);
  }

  .post-list {
    display: grid;
    gap: 0.75rem;
  }

  @media (max-width: 640px) {
    .post-list {
      gap: 2rem;
    }
  }

  .empty {
    color: var(--text-secondary);
  }
</style>

<script is:inline>
  (function() {
    var buttons = document.querySelectorAll('.filter-tag')
    var cards = document.querySelectorAll('.post-list .card')

    buttons.forEach(function(btn) {
      btn.addEventListener('click', function() {
        var tag = btn.dataset.tag

        buttons.forEach(function(b) { b.classList.remove('active') })
        btn.classList.add('active')

        cards.forEach(function(card) {
          if (tag === 'all') {
            card.style.display = ''
          } else {
            var cardTags = (card.dataset.tags || '').split(',')
            card.style.display = cardTags.indexOf(tag) !== -1 ? '' : 'none'
          }
        })
      })
    })
  })()
</script>
