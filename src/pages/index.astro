---
//import { CldImage } from 'astro-cloudinary';
import Layout from '/src/layouts/Layout.astro'
import Card from '/src/components/Card.astro'
import GithubActivity from '/src/components/GithubActivity.astro'
---

<!-- TODO: set up home title -->
<Layout title="Main">
    <!-- Blog Section -->
    <section class="blog">
      <h2>Blog</h2>
      <div class="link-card-grid">
        <!--<Card title="My Latest Post" description="Learn how to build Astro sites like a pro" href="/blog/latest" />-->
        <!--<Card title="Node & React Tips" description="Tips for fullstack development" href="/blog/node-react" />-->
      </div>
    </section>

    <GithubActivity />
</Layout>

<style>
  section {
    margin-bottom: 3rem;
  }

  h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
    color: var(--accent-light);
  }

  .link-card-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(24ch, 1fr));
    gap: 2rem;
  }
</style>
