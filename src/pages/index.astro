---
import Layout from '/src/layouts/Layout.astro'
import BlogCard from '/src/components/BlogCard.astro'
import { getCollection } from 'astro:content'
import { t, localePath } from '/src/i18n/utils'

const locale = 'en'
const i = t(locale)

const posts = await getCollection('blog', ({ data }) => (data.locale ?? 'en') === 'en')
const recentPosts = posts
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
  .slice(0, 3)
---

<Layout title={i.home.title} description={i.home.description} pageType="home">
  <section class="hero">
    <h1>{i.home.heading}</h1>
    <p>{i.home.description}</p>
  </section>

  {recentPosts.length > 0 && (
    <section>
      <div class="section-header">
        <h2>{i.home.recentPosts}</h2>
        <a href={localePath('/blog', locale)}>{i.home.viewAll}</a>
      </div>
      <div class="post-grid">
        {recentPosts.map((post) => (
          <BlogCard
            title={post.data.title}
            description={post.data.description}
            href={localePath(`/blog/${post.slug}`, locale)}
            imgSrc={post.data.imgSrc}
            imgAlt={post.data.imgAlt}
            tags={post.data.tags}
            date={post.data.pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          />
        ))}
      </div>
    </section>
  )}
</Layout>

<style>
  .hero {
    padding: 2.5rem 0 4rem;
  }

  .hero h1 {
    margin-bottom: 1rem;
  }

  .hero p {
    max-width: 560px;
    font-size: clamp(1.05rem, 1rem + 0.25vw, 1.15rem);
    line-height: 1.7;
  }

  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    margin-bottom: 1rem;
    gap: 1rem;
  }

  .section-header a {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--text-secondary);
    white-space: nowrap;
    padding: 0.35rem 0.85rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .section-header a:hover {
    color: var(--text);
    border-color: var(--text-secondary);
    background: var(--card-hover);
  }

  .post-grid {
    display: grid;
    gap: 0.75rem;
  }
</style>
