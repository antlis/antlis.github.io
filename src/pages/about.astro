---
import Layout from '/src/layouts/Layout.astro'
import TechStackBadges from '/src/components/TechStackBadges.astro'
import { t } from '/src/i18n/utils'

const i = t('en')
const primaryStack = ['TypeScript', 'JavaScript', 'Vue', 'Nuxt', 'React', 'Next.js']
const toolingStack = ['Astro', 'Node.js', 'Bun', 'Docker', 'Git', 'SASS']
---

<Layout title={i.about.title} description={i.about.description} pageType="about">
  <section class="about">
    <h1>{i.about.heading}</h1>
    <p>
      I build frontend-heavy products and the tools around them: Vue/Nuxt and
      React/Next applications, TypeScript-heavy interfaces, small CLI utilities,
      editor integrations, and self-hosted systems that solve real day-to-day
      problems.
    </p>

    <h2>What I Do</h2>
    <p>
      I work across the full frontend stack: component architecture, state
      management, accessibility, performance, build tooling, and the product
      details that turn a screen into something people can use repeatedly. My
      day-to-day stack is Vue 3, Nuxt, React, Next.js, and TypeScript, but a lot
      of the work is simply reading a codebase carefully and moving it in a
      safer direction.
    </p>
    <p>
      I care about maintainable code that other developers can work with:
      boring abstractions where possible, tests where behavior matters, and
      documentation that explains the decisions rather than repeating the code.
      I have led frontend work on production applications for media and fintech
      products, and I am comfortable balancing design polish with delivery
      constraints.
    </p>

    <section class="tech-section" aria-labelledby="tech-stack-title">
      <h2 id="tech-stack-title">Tech Stack</h2>
      <div class="stack-groups">
        <div>
          <h3>Frontend</h3>
          <TechStackBadges items={primaryStack} ariaLabel="Frontend stack" />
        </div>
        <div>
          <h3>Tools</h3>
          <TechStackBadges items={toolingStack} ariaLabel="Tooling stack" />
        </div>
      </div>
    </section>

    <h2>Open Source and Writing</h2>
    <p>
      I also build small open-source tools when an annoyance keeps repeating:
      Telegram media bots, terminal helpers, editor plugins, and experiments
      around self-hosting. The blog is where I write down the practical parts:
      what broke, what fixed it, and what I would do differently next time. You
      can find the code on <a href="https://github.com/antlis">GitHub</a>.
    </p>
  </section>
</Layout>

<style>
  .about {
    max-width: 640px;
    padding-top: 2rem;
  }

  .about h1 {
    margin-bottom: 1.5rem;
  }

  .about h2 {
    margin-top: 2rem;
    margin-bottom: 0.75rem;
  }

  .tech-section {
    margin: 2.8rem 0 3rem;
    padding-top: 2rem;
    border-top: 1px solid var(--border);
  }

  .tech-section h2 {
    margin-top: 0;
    margin-bottom: 1.35rem;
  }

  .stack-groups {
    display: grid;
    gap: 1.85rem;
  }

  .stack-groups > div {
    display: grid;
    gap: 0.85rem;
  }

  .stack-groups h3 {
    margin: 0;
    color: var(--text-secondary);
    font-size: 0.76rem;
    font-weight: 750;
    letter-spacing: 0.06em;
    line-height: 1.25;
    text-transform: uppercase;
  }

  .stack-groups > div + div {
    padding-top: 0.1rem;
  }

  .about p {
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.1rem);
    line-height: 1.75;
    margin-bottom: 1.25rem;
  }

  .about a {
    color: var(--accent);
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  .about a:hover {
    color: var(--accent-hover);
  }
</style>
