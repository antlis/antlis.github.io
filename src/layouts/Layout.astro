---
import "modern-css-reset"
import Footer from '../components/Footer.astro'
import Header from '../components/Header.astro'
import Socials from '../components/Socials.astro'
import SEO from '../components/SEO.astro'
import { ThemeScript } from 'astro-theme-toggle/components';
import { ClientRouter } from 'astro:transitions';
import { getLocaleFromUrl, t } from '../i18n/utils'

interface Props {
	title: string;
	description?: string;
	image?: string;
	type?: 'website' | 'article';
	publishedTime?: Date;
	modifiedTime?: Date;
	pageType?: 'home' | 'about' | 'contact' | 'blog-listing' | 'portfolio-listing' | 'blog-post';
	tags?: string[];
}

const { title, description, image, type, publishedTime, modifiedTime, pageType, tags } = Astro.props
const locale = getLocaleFromUrl(Astro.url)
const i = t(locale)
const wip = import.meta.env.PUBLIC_WIP === 'true'
const wipTitle = locale === 'ru' ? 'Антон Л — Скоро' : 'Anton L — Coming Soon'
const metaDescription = description || i.home.description
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="UTF-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="generator" content={Astro.generator} />
		<meta name="theme-color" content="#0a0a0a" media="(prefers-color-scheme: dark)" />
		<meta name="theme-color" content="#fafafa" media="(prefers-color-scheme: light)" />
		<title>{wip ? wipTitle : title}</title>
		<SEO
			title={wip ? wipTitle : title}
			description={metaDescription}
			locale={locale}
			image={image}
			type={type}
			publishedTime={publishedTime}
			modifiedTime={modifiedTime}
			pageType={pageType}
			tags={tags}
		/>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet">
    <ThemeScript />
    <ClientRouter />
	</head>

	<body>
    <a class="skip-link" href="#main-content">{locale === 'ru' ? 'Перейти к содержимому' : 'Skip to content'}</a>
		{!wip && <Header />}

		<main id="main-content" tabindex="-1">
			{wip ? (
				<div class="wip">
					<div class="wip-content">
						<img src="/logo.svg" alt="Logo" class="wip-logo" />
						<h1>{locale === 'ru' ? 'Сайт в разработке' : 'Work in progress'}</h1>
						<p>{locale === 'ru' ? 'Сайт находится в процессе создания. Загляните позже.' : 'This site is currently being built. Check back soon.'}</p>
						<Socials />
					</div>
				</div>
			) : (
				<slot />
			)}
		</main>

		{!wip && <Footer />}
	</body>
</html>

<style is:global>
	:root {
    --bg: #fafafa;
    --text: #1a1a1a;
    --text-secondary: #555;
    --border: #e5e5e5;
    --card-bg: #fff;
    --card-hover: #f5f5f5;
    --accent: #3b82f6;
    --accent-hover: #2563eb;
    --icon-color: #1a1a1a;
	}

  :root[data-theme='dark'] {
    --bg: #0a0a0a;
    --text: #e5e5e5;
    --text-secondary: #b0b0b0;
    --border: #2a2a2a;
    --card-bg: #111;
    --card-hover: #1d1d1d;
    --accent: #60a5fa;
    --accent-hover: #93bbfd;
    --icon-color: #e5e5e5;
  }

  html {
    font-family: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
  }

  body {
    background: var(--bg);
    color: var(--text);
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
  }

  main {
    flex: 1;
    width: 100%;
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem clamp(1rem, 3vw, 2rem);
  }

  a {
    text-decoration: none;
    color: inherit;
    transition: color 0.2s;
  }

  :focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
    border-radius: 2px;
  }

  .skip-link {
    position: fixed;
    left: 1rem;
    top: 1rem;
    z-index: 10000;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    padding: 0.55rem 0.85rem;
    color: var(--bg);
    background: var(--text);
    border-radius: 6px;
    font-size: 0.875rem;
    font-weight: 600;
  }

  .skip-link:focus-visible {
    width: auto;
    height: auto;
    overflow: visible;
    clip-path: none;
    white-space: normal;
  }

  h1, h2, h3, h4 {
    font-weight: 600;
    line-height: 1.3;
    color: var(--text);
  }

  h1 { font-size: clamp(1.75rem, 1.4rem + 1.5vw, 2.25rem); }
  h2 { font-size: clamp(1.25rem, 1.1rem + 0.75vw, 1.5rem); }
  h3 { font-size: clamp(1.1rem, 1rem + 0.5vw, 1.25rem); }

  p {
    line-height: 1.7;
    color: var(--text-secondary);
  }

	code {
    font-size: 0.875rem;
    padding: 0.2rem 0.4rem;
    background: var(--card-bg);
    border: 1px solid var(--border);
    border-radius: 4px;
		font-family: 'SF Mono', 'Fira Code', 'Fira Mono', Menlo, monospace;
	}

  .wip {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 90vh;
  }

  .wip-content {
    text-align: center;
  }

  .wip-logo {
    width: 80px;
    height: 80px;
    margin: 0 auto 2rem;
  }

  .wip h1 {
    font-size: 2rem;
    margin-bottom: 0.75rem;
  }

  .wip p {
    font-size: 1.1rem;
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }
</style>
