---
import { Icon } from 'astro-icon/components'

interface Props {
  items: string[]
  ariaLabel?: string
}

const { items, ariaLabel = 'Tech stack' } = Astro.props

const techIcons: Record<string, string> = {
  astro: 'devicon:astro',
  bun: 'devicon:bun',
  css: 'devicon:css3',
  docker: 'devicon:docker',
  ejs: 'simple-icons:ejs',
  git: 'devicon:git',
  html: 'devicon:html5',
  javascript: 'devicon:javascript',
  next: 'devicon:nextjs',
  'next.js': 'devicon:nextjs',
  node: 'devicon:nodejs',
  'node.js': 'devicon:nodejs',
  nuxt: 'devicon:nuxtjs',
  php: 'devicon:php',
  react: 'devicon:react',
  sass: 'devicon:sass',
  scss: 'devicon:sass',
  typescript: 'devicon:typescript',
  vue: 'devicon:vuejs',
  webpack: 'devicon:webpack',
}

function stackIcon(item: string) {
  return techIcons[item.trim().toLowerCase()]
}
---

<div class="tech-stack" aria-label={ariaLabel}>
  {items.map((item) => {
    const icon = stackIcon(item)
    return (
      <span class="tech-badge">
        {icon && <Icon name={icon} size="16" aria-hidden="true" />}
        <span>{item}</span>
      </span>
    )
  })}
</div>

<style>
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.5rem;
  }

  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    min-height: 1.85rem;
    padding: 0.26rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card-bg);
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .tech-badge :global(svg) {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
  }

  .tech-badge span {
    line-height: 1.2;
  }
</style>
