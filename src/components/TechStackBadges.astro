---
import { Icon } from 'astro-icon/components'

type StackItem = string | {
  label: string
  href?: string
}

interface Props {
  items: StackItem[]
  ariaLabel?: string
}

const { items, ariaLabel = 'Tech stack' } = Astro.props

const techIcons: Record<string, string> = {
  astro: 'devicon:astro',
  bun: 'devicon:bun',
  css: 'devicon:css3',
  docker: 'devicon:docker',
  ejs: 'simple-icons:ejs',
  git: 'devicon:git',
  html: 'devicon:html5',
  javascript: 'devicon:javascript',
  neovim: 'devicon:neovim',
  nvim: 'devicon:neovim',
  next: 'devicon:nextjs',
  'next.js': 'devicon:nextjs',
  node: 'devicon:nodejs',
  'node.js': 'devicon:nodejs',
  nuxt: 'devicon:nuxtjs',
  php: 'devicon:php',
  react: 'devicon:react',
  sass: 'devicon:sass',
  scss: 'devicon:sass',
  typescript: 'devicon:typescript',
  vue: 'devicon:vuejs',
  webpack: 'devicon:webpack',
}

function stackIcon(item: string) {
  return techIcons[item.trim().toLowerCase()]
}

function normalizeItem(item: StackItem) {
  return typeof item === 'string' ? { label: item } : item
}
---

<div class="tech-stack" aria-label={ariaLabel}>
  {items.map((item) => {
    const { label, href } = normalizeItem(item)
    const icon = stackIcon(label)
    const Tag = href ? 'a' : 'span'
    return (
      <Tag class="tech-badge" href={href} target={href ? '_blank' : undefined} rel={href ? 'noopener noreferrer' : undefined}>
        {icon && <Icon name={icon} size="16" aria-hidden="true" />}
        <span>{label}</span>
      </Tag>
    )
  })}
</div>

<style>
  .tech-stack {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem 0.5rem;
  }

  .tech-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.38rem;
    min-height: 1.85rem;
    padding: 0.26rem 0.6rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background: var(--card-bg);
    color: var(--text-secondary);
    font-size: 0.78rem;
    font-weight: 650;
    line-height: 1.2;
  }

  a.tech-badge {
    text-decoration: none;
    transition: color 0.18s ease, border-color 0.18s ease, background 0.18s ease, transform 0.18s ease;
  }

  a.tech-badge:hover {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 42%, var(--border));
    background: color-mix(in srgb, var(--accent) 7%, var(--card-bg));
    transform: translateY(-1px);
  }

  .tech-badge :global(svg) {
    flex: 0 0 auto;
    width: 1rem;
    height: 1rem;
  }

  .tech-badge span {
    line-height: 1.2;
  }
</style>
