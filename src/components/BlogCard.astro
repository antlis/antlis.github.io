---
import HeroImage from '/src/components/HeroImage.astro'

interface Props {
  title: string
  description: string
  href: string
  imgSrc?: string
  imgAlt?: string
  category?: string
  tags?: string[]
  draft?: boolean
  date?: string
  tagsAsFilters?: boolean
  tagHrefBase?: string
}

const { href, title, description, imgAlt, imgSrc, category, tags, date, tagsAsFilters = false, tagHrefBase } = Astro.props
---

<article
  class:list={['blog-card', { 'blog-card-with-img': Boolean(imgSrc) }]}
  data-tags={tags?.join(',') || ''}
  data-category={category || ''}
>
  <div class="blog-card-content">
    {(category || date) && (
      <div class="blog-card-meta">
        {category && <span class="blog-card-category">{category}</span>}
        {date && (
          <time class="blog-card-date">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <rect x="3" y="4" width="18" height="18" rx="2" ry="2" />
              <line x1="16" y1="2" x2="16" y2="6" />
              <line x1="8" y1="2" x2="8" y2="6" />
              <line x1="3" y1="10" x2="21" y2="10" />
            </svg>
            {date}
          </time>
        )}
      </div>
    )}
    <h3><a class="blog-card-title-link" href={href}>{title}</a></h3>
    <p>{description}</p>
    {tags && tags.length > 0 && (
      <div class="blog-card-tags">
        {tags.map((tag) =>
          tagsAsFilters ? (
            <button class="blog-card-tag" type="button" data-tag={tag} aria-label={`Filter posts by tag ${tag}`}>{tag}</button>
          ) : (
            <a class="blog-card-tag" href={`${tagHrefBase || '/blog'}?tag=${encodeURIComponent(tag)}`}>{tag}</a>
          )
        )}
      </div>
    )}
  </div>
  {imgSrc && (
    <a class="blog-card-img" href={href} aria-label={title}>
      <HeroImage
        src={imgSrc}
        alt={imgAlt || title}
        width={360}
        height={225}
        loading="lazy"
      />
    </a>
  )}
</article>

<style>
  .blog-card {
    position: relative;
    display: block;
    padding: 1.15rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .blog-card:hover {
    background: color-mix(in srgb, var(--card-bg) 84%, var(--card-hover));
    border-color: color-mix(in srgb, var(--accent) 36%, var(--border));
    box-shadow: 0 14px 34px color-mix(in srgb, #000 8%, transparent);
    transform: translateY(-1px);
  }

  .blog-card:focus-within {
    border-color: var(--accent);
  }

  .blog-card-with-img {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 180px;
    align-items: center;
    gap: 1.1rem;
    padding: 1rem;
  }

  .blog-card-content {
    position: relative;
    z-index: 1;
    min-width: 0;
  }

  .blog-card-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.45rem 0.65rem;
    margin-bottom: 0.55rem;
  }

  .blog-card-category {
    display: inline-flex;
    align-items: center;
    min-height: 1.35rem;
    padding: 0.12rem 0.48rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border));
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
  }

  .blog-card h3 {
    margin: 0 0 0.45rem;
    font-size: clamp(1rem, 0.95rem + 0.2vw, 1.08rem);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .blog-card-title-link {
    color: var(--text);
    text-decoration: none;
  }

  .blog-card-title-link::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    border-radius: 8px;
  }

  .blog-card h3 a:hover,
  .blog-card:hover .blog-card-title-link {
    color: var(--accent);
  }

  .blog-card-date {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .blog-card-date svg {
    flex-shrink: 0;
  }

  .blog-card p {
    margin: 0;
    font-size: 0.9rem;
    line-height: 1.58;
    color: var(--text-secondary);
  }

  .blog-card-tags {
    position: relative;
    z-index: 2;
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .blog-card-tag {
    display: inline-flex;
    align-items: center;
    cursor: pointer;
    font-family: inherit;
    font-size: 0.7rem;
    padding: 0.18rem 0.52rem;
    background: color-mix(in srgb, var(--card-hover) 86%, transparent);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
    transition: color 0.2s, border-color 0.2s, background 0.2s;
  }

  .blog-card-tag:hover {
    color: var(--text);
    border-color: var(--text-secondary);
  }

  .blog-card-img {
    position: relative;
    z-index: 1;
    width: 100%;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-hover);
    display: block;
  }

  .blog-card-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    display: block;
  }

  @media (max-width: 560px) {
    .blog-card-with-img {
      grid-template-columns: 1fr;
      gap: 0;
      padding: 0;
      overflow: hidden;
    }

    .blog-card-with-img .blog-card-content {
      padding: 1.25rem;
    }

    .blog-card-img {
      order: -1;
      border: 0;
      border-bottom: 1px solid var(--border);
      border-radius: 0;
    }
  }
</style>
