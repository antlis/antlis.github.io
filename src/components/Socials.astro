---
import { Icon } from 'astro-icon/components'

// Icons are inlined at build time from @iconify-json/simple-icons, so they
// render with currentColor (theme-aware, no CDN request) and can take their
// service's brand color on hover (DESIGN.md → Borrowed Brand Rule).
const socials = [
  {
    name: "GitHub",
    url: "https://github.com/antlis",
    icon: "simple-icons:github",
    brand: "github",
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/antlis/",
    icon: "simple-icons:linkedin",
    brand: "linkedin",
  },
  {
    name: "X",
    url: "https://x.com/antlis5",
    icon: "simple-icons:x",
    brand: "x",
  },
  {
    name: "GitLab",
    url: "https://gitlab.com/antlis",
    icon: "simple-icons:gitlab",
    brand: "gitlab",
  },
  {
    name: "StackOverflow",
    url: "https://stackoverflow.com/users/2983061/antlis",
    icon: "simple-icons:stackoverflow",
    brand: "stackoverflow",
  },
  {
    name: "Telegram",
    url: "https://t.me/Balkon1111",
    icon: "simple-icons:telegram",
    brand: "telegram",
  },
  {
    name: "Email",
    url: "mailto:antlis@protonmail.com",
    icon: "simple-icons:protonmail",
    brand: "email",
  },
];
---

<div class="socials">
  {socials.map(social => (
    <a href={social.url} target="_blank" rel="noopener" aria-label={social.name} data-brand={social.brand}>
      <Icon name={social.icon} width="20" height="20" aria-hidden="true" />
    </a>
  ))}
</div>

<style>
  .socials {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .socials a {
    --brand: var(--text-secondary);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin: -6px;
    color: var(--text);
    transition: color 0.2s, transform 0.2s;
  }

  .socials a:hover,
  .socials a:focus-visible {
    color: var(--brand);
    transform: scale(1.1);
  }

  .socials svg {
    width: 20px;
    height: 20px;
  }

  /* Brand colors tuned to clear 3:1 against the page background per theme */
  .socials a[data-brand="linkedin"] { --brand: #0a66c2; }
  .socials a[data-brand="gitlab"] { --brand: #e24329; }
  .socials a[data-brand="stackoverflow"] { --brand: #c4600f; }
  .socials a[data-brand="telegram"] { --brand: #1c8adb; }
  .socials a[data-brand="email"] { --brand: #6d4aff; }

  :global([data-theme='dark']) .socials a[data-brand="linkedin"] { --brand: #4d8fd6; }
  :global([data-theme='dark']) .socials a[data-brand="gitlab"] { --brand: #fc6d26; }
  :global([data-theme='dark']) .socials a[data-brand="stackoverflow"] { --brand: #f48024; }
  :global([data-theme='dark']) .socials a[data-brand="telegram"] { --brand: #26a5e4; }
  :global([data-theme='dark']) .socials a[data-brand="email"] { --brand: #9b85ff; }
</style>
