---
const socials = [
  {
    name: "GitHub",
    url: "https://github.com/antlis",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/github.svg",
    brand: "github",
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/antlis/",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/linkedin.svg",
    brand: "linkedin",
  },
  {
    name: "X",
    url: "https://x.com/antlis5",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/x.svg",
    brand: "x",
  },
  {
    name: "GitLab",
    url: "https://gitlab.com/antlis",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/gitlab.svg",
    brand: "gitlab",
  },
  {
    name: "StackOverflow",
    url: "https://stackoverflow.com/users/2983061/antlis",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/stackoverflow.svg",
    brand: "stackoverflow",
  },
  {
    name: "Telegram",
    url: "https://t.me/Balkon1111",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/telegram.svg",
    brand: "telegram",
  },
  {
    name: "Email",
    url: "mailto:antlis@protonmail.com",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/protonmail.svg",
    brand: "email",
  },
];
---

<div class="socials">
  {socials.map(social => (
    <a href={social.url} target="_blank" rel="noopener" aria-label={social.name} data-brand={social.brand}>
      <img src={social.icon} alt={social.name} width="20" height="20" />
    </a>
  ))}
</div>

<style>
  .socials {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .socials a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin: -6px;
    opacity: 1;
    transition: opacity 0.2s, transform 0.2s;
  }

  .socials a:hover {
    opacity: 1;
    transform: scale(1.1);
  }

  .socials img {
    width: 20px;
    height: 20px;
    max-width: 20px;
    max-height: 20px;
    filter: brightness(0);
    transition: filter 0.2s;
  }

  :global([data-theme='dark']) .socials img {
    filter: brightness(0) invert(1);
  }

  .socials a[data-brand]:hover img {
    filter: brightness(0) invert(0.15);
  }

  .socials a[data-brand="linkedin"]:hover img {
    filter: invert(39%) sepia(97%) saturate(547%) hue-rotate(184deg) brightness(94%) contrast(91%);
  }

  .socials a[data-brand="gitlab"]:hover img {
    filter: invert(59%) sepia(91%) saturate(779%) hue-rotate(358deg) brightness(97%) contrast(101%);
  }

  .socials a[data-brand="stackoverflow"]:hover img {
    filter: invert(55%) sepia(93%) saturate(813%) hue-rotate(8deg) brightness(101%) contrast(103%);
  }

  .socials a[data-brand="telegram"]:hover img {
    filter: invert(58%) sepia(62%) saturate(490%) hue-rotate(176deg) brightness(93%) contrast(94%);
  }

  .socials a[data-brand="email"]:hover img {
    filter: invert(42%) sepia(83%) saturate(585%) hue-rotate(228deg) brightness(98%) contrast(95%);
  }
</style>
