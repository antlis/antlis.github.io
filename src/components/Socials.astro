---
const socials = [
  {
    name: "GitHub",
    url: "https://github.com/antlis",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/github.svg",
  },
  {
    name: "LinkedIn",
    url: "https://www.linkedin.com/in/antlis/",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/linkedin.svg",
  },
  {
    name: "GitLab",
    url: "https://gitlab.com/antlis",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/gitlab.svg",
  },
  {
    name: "StackOverflow",
    url: "https://stackoverflow.com/users/2983061/antlis",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/stackoverflow.svg",
  },
  {
    name: "Telegram",
    url: "https://t.me/Balkon1111",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/telegram.svg",
  },
  {
    name: "Email",
    url: "mailto:antlis@protonmail.com",
    icon: "https://cdn.jsdelivr.net/gh/simple-icons/simple-icons/icons/protonmail.svg",
  },
];
---

<div class="socials">
  {socials.map(social => (
    <a href={social.url} target="_blank" rel="noopener" aria-label={social.name}>
      <img src={social.icon} alt={social.name} width="20" height="20" />
    </a>
  ))}
</div>

<style>
  .socials {
    display: flex;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: center;
  }

  .socials a {
    display: flex;
    opacity: 0.5;
    transition: opacity 0.2s;
  }

  .socials a:hover {
    opacity: 0.8;
  }

  .socials img {
    width: 20px;
    height: 20px;
    max-width: 20px;
    max-height: 20px;
    filter: brightness(0);
  }

  :global([data-theme='dark']) .socials img {
    filter: brightness(0) invert(1);
  }
</style>
