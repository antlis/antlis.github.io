---
interface Props {
	title: string;
	body?: string;
	description?: string;
	href: string;
  imgSrc?: string;
  imgAlt?: string;
  tags?: string[];
  date?: string;
}

const { href, title, body, description, imgAlt, imgSrc, tags, date } = Astro.props;
const displayText = body || description || '';
---

<a href={href} class:list={["card", { "card-with-img": !!imgSrc }]} data-tags={tags?.join(',') || ''}>
  <div class="card-content">
    <h3>{title}</h3>
    {date && <time class="card-date">{date}</time>}
    {displayText && <p>{displayText}</p>}
    {tags && tags.length > 0 && (
      <div class="card-tags">
        {tags.map((tag) => (
          <span class="card-tag" data-tag={tag}>{tag}</span>
        ))}
      </div>
    )}
  </div>
  {imgSrc && (
    <div class="card-img">
      <img
        src={imgSrc}
        alt={imgAlt || title}
        width={200}
        height={200}
        loading="lazy"
        decoding="async"
      />
    </div>
  )}
</a>

<style>
  .card {
    display: block;
    padding: 1.25rem;
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    text-decoration: none;
    transition: background 0.2s, border-color 0.2s;
  }

  .card-with-img {
    display: flex;
    align-items: stretch;
    padding: 0;
    overflow: hidden;
  }

  .card-with-img .card-content {
    flex: 1;
    min-width: 0;
    padding: 1.25rem;
  }

  .card:hover {
    background: var(--card-hover);
    border-color: var(--text-secondary);
  }

  .card h3 {
    margin: 0 0 0.5rem;
    font-size: 1rem;
    font-weight: 600;
  }

  .card-date {
    display: block;
    margin: -0.25rem 0 0.5rem;
    font-size: 0.75rem;
    color: var(--text-secondary);
  }

  .card p {
    margin: 0;
    font-size: 0.875rem;
    line-height: 1.5;
    color: var(--text-secondary);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-top: 0.75rem;
  }

  .card-tag {
    font-size: 0.7rem;
    padding: 0.15rem 0.5rem;
    background: var(--card-hover);
    color: var(--text-secondary);
    border: 1px solid var(--border);
    border-radius: 999px;
  }

  .card-img {
    flex-shrink: 0;
    width: 140px;
  }

  .card-img :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  @media (max-width: 480px) {
    .card-with-img {
      flex-direction: column-reverse;
    }

    .card-img {
      width: 100%;
      height: 160px;
    }
  }
</style>
