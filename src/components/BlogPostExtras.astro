---
import type { CollectionEntry } from 'astro:content'
import type { Locale } from '../i18n/translations'
import { localePath } from '../i18n/utils'
import AdjacentNav from './AdjacentNav.astro'

interface Props {
  posts: CollectionEntry<'blog'>[]
  currentSlug: string
  locale: Locale
}

const { posts, currentSlug, locale } = Astro.props
const currentBaseSlug = currentSlug.replace(/-ru$/, '')
const routeSlug = (slug: string) => slug.replace(/-ru$/, '')
const postHref = (post: CollectionEntry<'blog'>) => localePath(`/blog/${routeSlug(post.slug)}`, locale)
const sortedPosts = [...posts].sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime())
const currentPost = sortedPosts.find((post) => post.slug === currentSlug)
const currentIndex = sortedPosts.findIndex((post) => post.slug === currentSlug)
const newerPost = currentIndex > 0 ? sortedPosts[currentIndex - 1] : undefined
const olderPost = currentIndex >= 0 && currentIndex < sortedPosts.length - 1 ? sortedPosts[currentIndex + 1] : undefined

const currentTags = new Set(currentPost?.data.tags || [])
const relatedPosts = currentPost
  ? sortedPosts
      .filter((post) => post.slug !== currentSlug)
      .map((post) => ({
        post,
        score:
          (post.data.tags || []).filter((tag) => currentTags.has(tag)).length * 2 +
          (post.data.category && post.data.category === currentPost.data.category ? 1 : 0),
      }))
      .filter((item) => item.score > 0)
      .sort((a, b) => b.score - a.score || b.post.data.pubDate.getTime() - a.post.data.pubDate.getTime())
      .slice(0, 3)
      .map((item) => item.post)
  : []

const seriesBaseSlugs = ['homelab-archcraft', 'tg-mpv-bot', 'tg-media-bot', 'docker-btrfs-disk-recovery']
const seriesPosts = seriesBaseSlugs
  .map((baseSlug) => posts.find((post) => routeSlug(post.slug) === baseSlug))
  .filter((post): post is CollectionEntry<'blog'> => Boolean(post))
const showSeries = seriesBaseSlugs.includes(currentBaseSlug)

const labels = locale === 'ru'
  ? {
      previous: 'Старее',
      next: 'Новее',
      related: 'Похожие статьи',
      series: 'Серия про домашний сервер',
      current: 'Текущая',
    }
  : {
      previous: 'Older',
      next: 'Newer',
      related: 'Related Posts',
      series: 'Living-Room Server Series',
      current: 'Current',
    }
---

<footer class="post-extras">
  <AdjacentNav
    ariaLabel={locale === 'ru' ? 'Навигация по статьям' : 'Post navigation'}
    previous={olderPost && { href: postHref(olderPost), label: labels.previous, title: olderPost.data.title, direction: 'previous' }}
    next={newerPost && { href: postHref(newerPost), label: labels.next, title: newerPost.data.title, direction: 'next' }}
  />

  {showSeries && seriesPosts.length > 1 && (
    <section class="post-panel">
      <h2>{labels.series}</h2>
      <div class="compact-list">
        {seriesPosts.map((post, index) => {
          const isCurrent = post.slug === currentSlug
          return (
            <a href={postHref(post)} class:list={['compact-item', { active: isCurrent }]}>
              <span class="compact-index">{String(index + 1).padStart(2, '0')}</span>
              <span class="compact-title">{post.data.title}</span>
              {isCurrent && <em>{labels.current}</em>}
            </a>
          )
        })}
      </div>
    </section>
  )}

  {relatedPosts.length > 0 && (
    <section class="post-panel">
      <h2>{labels.related}</h2>
      <div class="related-grid">
        {relatedPosts.map((post) => (
          <a href={postHref(post)} class="related-card">
            <span class="related-meta">
              {post.data.category && <span class="related-category">{post.data.category}</span>}
              <time>{post.data.pubDate.toLocaleDateString(locale === 'ru' ? 'ru-RU' : 'en-US', { year: 'numeric', month: 'short', day: 'numeric' })}</time>
            </span>
            <strong>{post.data.title}</strong>
            <span class="related-description">{post.data.description}</span>
          </a>
        ))}
      </div>
    </section>
  )}
</footer>

<style>
  .post-extras {
    /* Matches ShareButtons' padding-top so the share row sits centered
       between its top border and this one (equal gap above and below). */
    margin-top: 1.5rem;
    padding-top: 0.4rem;
    border-top: 1px solid var(--border);
  }

  /* When no related/series panel follows the nav, drop its trailing divider
     so it doesn't leave an empty gap where the related posts would be. */
  .post-extras:not(:has(.post-panel)) :global(.adjacent-nav) {
    margin-bottom: 0;
    border-bottom: none;
  }

  .related-card {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--card-bg);
    transition: background 0.2s, border-color 0.2s, box-shadow 0.2s, transform 0.2s;
  }

  .related-card:hover,
  .compact-item:hover {
    background: color-mix(in srgb, var(--card-bg) 84%, var(--card-hover));
    border-color: color-mix(in srgb, var(--accent) 36%, var(--border));
  }

  .related-card:hover {
    box-shadow: 0 12px 28px color-mix(in srgb, #000 8%, transparent);
    transform: translateY(-1px);
  }

  .post-panel + .post-panel {
    margin-top: 2.1rem;
  }

  .post-panel h2 {
    margin: 0 0 1rem;
    color: var(--text);
    font-size: 0.9rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .compact-list {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
  }

  .compact-item {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.4rem;
    padding: 0.75rem 0.95rem;
    color: var(--text);
    border-radius: 8px;
    transition: color 0.18s ease, background 0.18s ease;
  }

  .compact-item:hover {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }

  .compact-item.active {
    background: color-mix(in srgb, var(--accent) 8%, transparent);
  }

  .compact-index {
    min-width: 2ch;
    color: var(--text-secondary);
    font-size: 0.76rem;
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .compact-title {
    min-width: 0;
    font-size: 0.92rem;
    line-height: 1.4;
  }

  .compact-item em {
    flex-shrink: 0;
    color: var(--text-secondary);
    font-size: 0.75rem;
    font-style: normal;
  }

  .related-grid {
    display: grid;
    gap: 1.15rem;
  }

  .related-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    padding: 0.85rem 0.95rem;
  }

  .related-card .related-meta {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    width: fit-content;
    max-width: 100%;
    gap: 0.45rem 0.65rem;
    margin-bottom: 0.4rem;
    color: var(--text-secondary);
    font-size: 0.74rem;
  }

  .related-card .related-category {
    display: inline-flex;
    align-items: center;
    flex: 0 0 auto;
    width: fit-content;
    max-width: 100%;
    min-height: 1.35rem;
    padding: 0.12rem 0.48rem;
    color: var(--accent);
    background: color-mix(in srgb, var(--accent) 8%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 24%, var(--border));
    border-radius: 999px;
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1;
  }

  .related-card strong {
    display: block;
    margin-bottom: 0.25rem;
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.4;
  }

  .related-description {
    display: block;
    color: var(--text-secondary);
    font-size: 0.82rem;
    line-height: 1.5;
  }
</style>
