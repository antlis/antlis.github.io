---
interface Props {
  apiBase?: string
}

const { apiBase = 'https://antlis-mcp.vercel.app' } = Astro.props
---

<div id="chat-widget" class="chat-widget" data-api-base={apiBase}>
  <div class="chat-header">
    <span class="chat-title">Ask about this site</span>
    <button class="chat-toggle" aria-label="Toggle chat" id="chat-toggle">
      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
      </svg>
    </button>
  </div>

  <div class="chat-body" id="chat-body">
    <div class="chat-messages" id="chat-messages">
      <div class="chat-suggestions" id="chat-suggestions">
        <p class="suggestions-label">Ask about this website</p>
        <button class="suggestion-btn" data-q="What projects use React?">What projects use React?</button>
        <button class="suggestion-btn" data-q="What have I written about AI?">What have I written about AI?</button>
        <button class="suggestion-btn" data-q="Tell me about the MCP server">How does the MCP work?</button>
        <button class="suggestion-btn" data-q="What are the most interesting projects?">Show me interesting projects</button>
      </div>
    </div>

    <form class="chat-input-form" id="chat-form">
      <input
        type="text"
        id="chat-input"
        class="chat-input"
        placeholder="Ask a question..."
        autocomplete="off"
        disabled
      />
      <button type="submit" class="chat-send" id="chat-send" disabled>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
          <line x1="22" y1="2" x2="11" y2="13"/>
          <polygon points="22 2 15 22 11 13 2 9 22 2"/>
        </svg>
      </button>
    </form>
  </div>
</div>

<style>
  .chat-widget {
    position: relative;
    max-width: 640px;
    margin: 2.5rem 0;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--card-bg);
    overflow: hidden;
  }

  .chat-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 0.75rem 1rem;
    border-bottom: 1px solid var(--border);
    background: var(--card-bg);
  }

  .chat-title {
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--text);
  }

  .chat-toggle {
    display: none;
    background: none;
    border: none;
    color: var(--text-secondary);
    cursor: pointer;
    padding: 0.25rem;
  }

  .chat-body {
    display: flex;
    flex-direction: column;
    height: 420px;
  }

  .chat-messages {
    flex: 1;
    overflow-y: auto;
    padding: 1rem;
    scroll-behavior: smooth;
  }

  .chat-suggestions {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 0;
  }

  .suggestions-label {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin-bottom: 0.25rem;
  }

  .suggestion-btn {
    display: block;
    width: 100%;
    text-align: left;
    padding: 0.6rem 0.85rem;
    font-size: 0.88rem;
    color: var(--accent);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 8px;
    cursor: pointer;
    transition: background 0.15s, border-color 0.15s;
  }

  .suggestion-btn:hover {
    background: color-mix(in srgb, var(--accent) 6%, transparent);
    border-color: var(--accent);
  }

  :global(.chat-msg) {
    margin-bottom: 1rem;
    max-width: 88%;
  }

  :global(.chat-msg.user) {
  }

  :global(.chat-msg-label) {
    font-size: 0.75rem;
    font-weight: 700;
    margin-bottom: 0.45rem;
    text-transform: uppercase;
    letter-spacing: 0.04em;
    color: var(--text-secondary);
  }

  :global(.chat-msg.user .chat-msg-label) {
    color: var(--accent);
  }

  .chat-msg-bubble {
    padding: 0.65rem 0.9rem;
    font-size: 0.9rem;
    line-height: 1.6;
    border-radius: 10px;
    white-space: pre-wrap;
    word-wrap: break-word;
  }

  .chat-msg.user .chat-msg-bubble {
    background: var(--accent);
    color: #fff;
    border-bottom-right-radius: 2px;
  }

  .chat-msg.assistant .chat-msg-bubble {
    background: var(--border);
    color: var(--text);
    border-bottom-left-radius: 2px;
  }

  :global(.chat-msg-bubble.markdown) {
    white-space: normal;
  }

  :global(.chat-msg-bubble.markdown > *:first-child) {
    margin-top: 0;
  }

  :global(.chat-msg-bubble.markdown > *:last-child) {
    margin-bottom: 0;
  }

  :global(.chat-msg-bubble.markdown p) {
    margin: 0 0 0.6rem;
  }

  :global(.chat-msg-bubble.markdown ul),
  :global(.chat-msg-bubble.markdown ol) {
    margin: 0 0 0.6rem;
    padding-left: 1.25rem;
  }

  :global(.chat-msg-bubble.markdown li) {
    margin: 0.2rem 0;
  }

  :global(.chat-msg-bubble.markdown a) {
    color: var(--accent);
    text-decoration: underline;
  }

  :global(.chat-msg-bubble.markdown code) {
    font-family: ui-monospace, SFMono-Regular, Menlo, Consolas, monospace;
    font-size: 0.85em;
    padding: 0.1rem 0.3rem;
    border-radius: 4px;
    background: color-mix(in srgb, var(--text) 10%, transparent);
  }

  :global(.chat-msg-bubble.markdown pre) {
    margin: 0 0 0.6rem;
    padding: 0.65rem 0.8rem;
    border-radius: 8px;
    overflow-x: auto;
    background: color-mix(in srgb, var(--text) 10%, transparent);
  }

  :global(.chat-msg-bubble.markdown pre code) {
    padding: 0;
    background: none;
    font-size: 0.82em;
  }

  :global(.chat-msg-bubble.markdown h1),
  :global(.chat-msg-bubble.markdown h2),
  :global(.chat-msg-bubble.markdown h3),
  :global(.chat-msg-bubble.markdown h4) {
    margin: 0.8rem 0 0.4rem;
    font-size: 1em;
    font-weight: 700;
    line-height: 1.3;
  }

  :global(.chat-msg-bubble.markdown blockquote) {
    margin: 0 0 0.6rem;
    padding-left: 0.75rem;
    border-left: 3px solid var(--border);
    color: var(--text-secondary);
  }

  :global(.chat-msg-bubble.markdown img) {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
  }

  :global(.chat-msg-bubble.markdown table) {
    border-collapse: collapse;
    width: 100%;
    margin: 0 0 0.6rem;
    font-size: 0.85em;
  }

  :global(.chat-msg-bubble.markdown th),
  :global(.chat-msg-bubble.markdown td) {
    border: 1px solid var(--border);
    padding: 0.3rem 0.5rem;
    text-align: left;
  }

  /* Standalone "thinking" indicator (before the first token / during tool calls) */
  :global(.chat-typing) {
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.8rem 0.9rem;
    background: var(--border);
    border-radius: 10px;
    border-bottom-left-radius: 2px;
  }

  /* Trailing indicator shown inside the bubble while the answer streams in */
  :global(.chat-typing-inline) {
    padding: 0.4rem 0 0.1rem;
    background: none;
    border-radius: 0;
  }

  :global(.chat-typing span) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-secondary);
    animation: typing 1.4s infinite ease-in-out both;
  }

  :global(.chat-typing span:nth-child(2)) { animation-delay: 0.2s; }
  :global(.chat-typing span:nth-child(3)) { animation-delay: 0.4s; }

  @keyframes typing {
    0%, 70%, 100% { opacity: 0.25; transform: translateY(0) scale(0.85); }
    35% { opacity: 1; transform: translateY(-4px) scale(1); }
  }

  .chat-input-form {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.75rem;
    border-top: 1px solid var(--border);
  }

  .chat-input {
    flex: 1;
    padding: 0.55rem 0.75rem;
    font-size: 0.88rem;
    font-family: inherit;
    color: var(--text);
    background: var(--bg);
    border: 1px solid var(--border);
    border-radius: 8px;
    outline: none;
    transition: border-color 0.15s;
  }

  .chat-input:focus {
    border-color: var(--accent);
  }

  .chat-input:disabled {
    opacity: 0.5;
  }

  .chat-send {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    flex-shrink: 0;
    background: var(--accent);
    color: #fff;
    border: none;
    border-radius: 8px;
    cursor: pointer;
    transition: opacity 0.15s;
  }

  .chat-send:disabled {
    opacity: 0.4;
    cursor: not-allowed;
  }

  .chat-send:not(:disabled):hover {
    opacity: 0.85;
  }

  @media (max-width: 640px) {
    .chat-widget {
      margin: 1.5rem 0;
    }

    .chat-body {
      height: 380px;
    }

    .chat-msg {
      max-width: 95%;
    }

    .suggestion-btn {
      font-size: 0.84rem;
      padding: 0.55rem 0.75rem;
    }

    .chat-input {
      font-size: 16px;
    }
  }
</style>

<script>
  import { marked } from 'marked'
  import DOMPurify from 'dompurify'

  marked.setOptions({ breaks: true, gfm: true })

  const widget = document.getElementById('chat-widget')!
  const apiBase = widget.dataset.apiBase
  const messages = document.getElementById('chat-messages')!
  const form = document.getElementById('chat-form')!
  const input = document.getElementById('chat-input') as HTMLInputElement
  const sendBtn = document.getElementById('chat-send') as HTMLButtonElement
  const suggestions = document.getElementById('chat-suggestions')

  let conversation: { role: string; content: string }[] = []
  let isLoading = false

  input.disabled = false
  sendBtn.disabled = false

  function scrollToBottom() {
    messages.scrollTop = messages.scrollHeight
  }

  function addUserMessage(text: string) {
    const div = document.createElement('div')
    div.className = 'chat-msg user'
    div.innerHTML = `
      <div class="chat-msg-label">You:</div>
      <div class="chat-msg-bubble">${escapeHtml(text)}</div>
    `
    messages.appendChild(div)
    scrollToBottom()
  }

  function renderMarkdown(text: string) {
    return DOMPurify.sanitize(marked.parse(text ?? '', { async: false }))
  }

  function createAssistantBubble(): HTMLElement {
    const div = document.createElement('div')
    div.className = 'chat-msg assistant'
    const label = document.createElement('div')
    label.className = 'chat-msg-label'
    label.textContent = 'Assistant:'
    const bubble = document.createElement('div')
    bubble.className = 'chat-msg-bubble markdown'
    div.append(label, bubble)
    messages.appendChild(div)
    scrollToBottom()
    return bubble
  }

  function addAssistantMessage(text: string) {
    createAssistantBubble().innerHTML = renderMarkdown(text)
  }

  function showTyping() {
    const div = document.createElement('div')
    div.className = 'chat-msg assistant'
    div.id = 'typing-indicator'
    div.innerHTML = `
      <div class="chat-msg-label">Assistant:</div>
      <div class="chat-typing"><span></span><span></span><span></span></div>
    `
    messages.appendChild(div)
    scrollToBottom()
  }

  function removeTyping() {
    const el = document.getElementById('typing-indicator')
    if (el) el.remove()
  }

  function escapeHtml(str: string) {
    const div = document.createElement('div')
    div.textContent = str
    return div.innerHTML
  }

  // Stream the reply from /api/stream. Returns true if anything was shown,
  // false if nothing streamed (caller falls back to /api/chat).
  async function streamReply(): Promise<boolean> {
    let res: Response
    try {
      res = await fetch(apiBase + '/api/stream', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: conversation }),
      })
    } catch {
      return false
    }

    if (!res.ok || !res.body) return false

    const reader = res.body.getReader()
    const decoder = new TextDecoder()
    let sseBuffer = ''
    let answer = ''
    let bubble: HTMLElement | null = null
    let raf = 0

    const DOTS =
      '<span class="chat-typing chat-typing-inline"><span></span><span></span><span></span></span>'
    const render = (streaming: boolean) => {
      if (!bubble) return
      bubble.innerHTML = renderMarkdown(answer) + (streaming ? DOTS : '')
      scrollToBottom()
    }
    const flush = () => {
      raf = 0
      render(true)
    }
    const scheduleRender = () => {
      if (!raf) raf = requestAnimationFrame(flush)
    }

    try {
      while (true) {
        const { value, done } = await reader.read()
        if (done) break
        sseBuffer += decoder.decode(value, { stream: true })
        const lines = sseBuffer.split('\n')
        sseBuffer = lines.pop() ?? ''

        for (const line of lines) {
          const trimmed = line.trim()
          if (!trimmed.startsWith('data:')) continue
          const payload = trimmed.slice(5).trim()
          if (!payload || payload === '[DONE]') continue

          let evt: any
          try {
            evt = JSON.parse(payload)
          } catch {
            continue
          }

          if (evt.type === 'delta') {
            if (!bubble) {
              removeTyping()
              bubble = createAssistantBubble()
            }
            answer += evt.text
            scheduleRender()
          } else if (evt.type === 'error' && !bubble) {
            return false
          }
        }
      }
    } catch {
      if (!bubble) return false // mid-stream failure before anything shown
    }

    if (raf) cancelAnimationFrame(raf)
    if (!bubble || !answer) return false

    render(false) // final render without the trailing dots
    conversation.push({ role: 'assistant', content: answer })
    return true
  }

  // Non-streaming fallback against the original /api/chat endpoint.
  async function fallbackReply() {
    try {
      const res = await fetch(apiBase + '/api/chat', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ messages: conversation }),
      })

      if (!res.ok) {
        addAssistantMessage('Something went wrong. Please try again later.')
        conversation.pop()
        return
      }

      const data = await res.json()
      addAssistantMessage(data.response)
      conversation.push({ role: 'assistant', content: data.response })
    } catch {
      addAssistantMessage('Network error. Please try again.')
      conversation.pop()
    }
  }

  async function sendMessage(text: string) {
    if (isLoading || !text.trim()) return
    isLoading = true
    input.value = ''
    input.disabled = true
    sendBtn.disabled = true

    if (suggestions) suggestions.style.display = 'none'

    addUserMessage(text)
    conversation.push({ role: 'user', content: text })

    showTyping()

    try {
      const streamed = await streamReply()
      if (!streamed) await fallbackReply()
    } finally {
      removeTyping()
      isLoading = false
      input.disabled = false
      sendBtn.disabled = false
      input.focus()
    }
  }

  form.addEventListener('submit', (e) => {
    e.preventDefault()
    sendMessage(input.value)
  })

  document.querySelectorAll('.suggestion-btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      sendMessage((btn as HTMLElement).dataset.q ?? '')
    })
  })
</script>
