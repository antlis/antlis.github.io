---
import { switchLocalePath } from '../i18n/utils'
import type { Locale } from '../i18n/translations'

interface Props {
  title: string
  description: string
  locale: Locale
  image?: string
  type?: 'website' | 'article'
  publishedTime?: Date
}

const { title, description, locale, image, type = 'website', publishedTime } = Astro.props

const site = Astro.site!
const canonicalURL = new URL(Astro.url.pathname, site)
const alternateLang = locale === 'en' ? 'ru' : 'en'
const alternateURL = new URL(switchLocalePath(Astro.url.pathname, alternateLang as Locale), site)
const ogImage = image || new URL('/og-default.png', site).toString()

const jsonLd: Record<string, unknown> = type === 'article'
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: ogImage,
      url: canonicalURL.toString(),
      inLanguage: locale,
      ...(publishedTime && { datePublished: publishedTime.toISOString() }),
      author: {
        '@type': 'Person',
        name: 'Anton L',
        url: site.toString(),
      },
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Anton L',
      url: site.toString(),
      inLanguage: locale,
      author: {
        '@type': 'Person',
        name: 'Anton L',
        url: site.toString(),
      },
    }
---

<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={locale} href={canonicalURL} />
<link rel="alternate" hreflang={alternateLang} href={alternateURL} />
<link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonicalURL : alternateURL} />

<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ru_RU'} />
<meta property="og:locale:alternate" content={locale === 'en' ? 'ru_RU' : 'en_US'} />
<meta property="og:site_name" content="Anton L" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="alternate" type="application/rss+xml" title="Anton L — Blog" href={new URL('/rss.xml', site)} />

<script is:inline type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
