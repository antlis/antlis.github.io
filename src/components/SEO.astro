---
import { switchLocalePath } from '../i18n/utils'
import type { Locale } from '../i18n/translations'

interface Props {
  title: string
  description: string
  locale: Locale
  image?: string
  type?: 'website' | 'article'
  publishedTime?: Date
  pageType?: 'home' | 'about' | 'contact' | 'blog-listing' | 'portfolio-listing' | 'blog-post'
  tags?: string[]
}

const { title, description, locale, image, type = 'website', publishedTime, pageType, tags } = Astro.props

const site = Astro.site!
const siteUrl = site.toString().replace(/\/$/, '')
const canonicalURL = new URL(Astro.url.pathname, site)
const alternateLang = locale === 'en' ? 'ru' : 'en'
const alternateURL = new URL(switchLocalePath(Astro.url.pathname, alternateLang as Locale), site)
const ogImage = image || new URL('/og-default.png', site).toString()

const authorSchema = {
  '@type': 'Person',
  name: 'Anton L',
  url: siteUrl,
  sameAs: [
    'https://github.com/antlis',
    'https://www.linkedin.com/in/antlis/',
  ],
}

function buildJsonLd() {
  const schemas: Record<string, unknown>[] = []

  if (pageType === 'home' || (!pageType && type === 'website')) {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: 'Anton L',
      url: siteUrl,
      inLanguage: locale,
      description,
      author: authorSchema,
    })

    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'Person',
      name: 'Anton L',
      url: siteUrl,
      jobTitle: 'Frontend Developer',
      sameAs: authorSchema.sameAs,
    })
  }

  if (pageType === 'about') {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'ProfilePage',
      name: title,
      description,
      url: canonicalURL.toString(),
      mainEntity: {
        '@type': 'Person',
        name: 'Anton L',
        url: siteUrl,
        jobTitle: 'Frontend Developer',
        sameAs: authorSchema.sameAs,
      },
    })
  }

  if (pageType === 'contact') {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'ContactPage',
      name: title,
      description,
      url: canonicalURL.toString(),
    })
  }

  if (pageType === 'blog-listing' || pageType === 'portfolio-listing') {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'CollectionPage',
      name: title,
      description,
      url: canonicalURL.toString(),
      inLanguage: locale,
      author: authorSchema,
    })
  }

  if (pageType === 'blog-post' || type === 'article') {
    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      image: ogImage,
      url: canonicalURL.toString(),
      inLanguage: locale,
      ...(publishedTime && { datePublished: publishedTime.toISOString() }),
      ...(tags && tags.length > 0 && { keywords: tags.join(', ') }),
      author: authorSchema,
      publisher: authorSchema,
      mainEntityOfPage: {
        '@type': 'WebPage',
        '@id': canonicalURL.toString(),
      },
    })
  }

  // Breadcrumb for all pages except home
  const pathSegments = Astro.url.pathname.replace(/\/$/, '').split('/').filter(Boolean)
  if (pathSegments.length > 0) {
    const items = [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
    ]

    let currentPath = ''
    pathSegments.forEach((segment, index) => {
      currentPath += `/${segment}`
      items.push({
        '@type': 'ListItem',
        position: index + 2,
        name: segment.charAt(0).toUpperCase() + segment.slice(1).replace(/-/g, ' '),
        item: `${siteUrl}${currentPath}`,
      })
    })

    schemas.push({
      '@context': 'https://schema.org',
      '@type': 'BreadcrumbList',
      itemListElement: items,
    })
  }

  return schemas
}

const schemas = buildJsonLd()
---

<link rel="canonical" href={canonicalURL} />
<link rel="alternate" hreflang={locale} href={canonicalURL} />
<link rel="alternate" hreflang={alternateLang} href={alternateURL} />
<link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonicalURL : alternateURL} />

<meta name="description" content={description} />

<meta property="og:type" content={type} />
<meta property="og:url" content={canonicalURL} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={ogImage} />
<meta property="og:locale" content={locale === 'en' ? 'en_US' : 'ru_RU'} />
<meta property="og:locale:alternate" content={locale === 'en' ? 'ru_RU' : 'en_US'} />
<meta property="og:site_name" content="Anton L" />
{publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
{tags && tags.length > 0 && tags.map((tag) => <meta property="article:tag" content={tag} />)}

<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={ogImage} />

<link rel="alternate" type="application/rss+xml" title="Anton L — Blog" href={new URL('/rss.xml', site)} />

{schemas.map((schema) => (
  <script is:inline type="application/ld+json" set:html={JSON.stringify(schema)} />
))}
