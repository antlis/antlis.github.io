---
import Socials from './Socials.astro'
import { getLocaleFromUrl, t } from '../i18n/utils'

const locale = getLocaleFromUrl(Astro.url)
const i = t(locale)
const rssHref = locale === 'ru' ? '/ru/rss.xml' : '/rss.xml'
const rssLabel = locale === 'ru' ? 'Подписаться на RSS' : 'Subscribe to RSS'
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <small class="copyright">&copy; {currentYear} {i.footer.copyright}</small>
    <div class="footer-actions">
      <a class="rss-link" href={rssHref} aria-label={rssLabel} title={rssLabel}>
        <svg aria-hidden="true" viewBox="0 0 24 24" width="20" height="20">
          <path d="M19.199 24C19.199 13.467 10.533 4.8 0 4.8V0c13.165 0 24 10.835 24 24h-4.801zM3.291 17.415c1.814 0 3.293 1.479 3.293 3.295 0 1.813-1.485 3.29-3.301 3.29C1.47 24 0 22.526 0 20.71s1.475-3.294 3.291-3.295zM15.909 24h-4.665c0-6.169-5.075-11.245-11.244-11.245V8.09c8.727 0 15.909 7.184 15.909 15.91z" fill="currentColor" />
        </svg>
      </a>
      <Socials />
    </div>
  </div>
</footer>

<script>
  function updateFooter() {
    const isRu = window.location.pathname.startsWith('/ru')
    const rssLink = document.querySelector('.rss-link')
    if (rssLink) {
      rssLink.setAttribute('href', isRu ? '/ru/rss.xml' : '/rss.xml')
      rssLink.setAttribute('aria-label', isRu ? 'Подписаться на RSS' : 'Subscribe to RSS')
      rssLink.setAttribute('title', isRu ? 'Подписаться на RSS' : 'Subscribe to RSS')
    }
  }

  updateFooter()
  document.addEventListener('astro:after-swap', updateFooter)
</script>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
  }

  @media (max-width: 640px) {
    footer {
      margin-top: 1rem;
    }
  }

  .footer-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 2rem clamp(1rem, 3vw, 2rem);
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }

  .footer-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  .rss-link {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    margin: -6px;
    color: var(--text-secondary);
    transition: color 0.2s;
  }

  .rss-link:hover,
  .rss-link:focus-visible {
    color: var(--accent-hover);
  }

  .rss-link svg {
    display: block;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
  }

  .footer-actions :global(.socials) {
    align-items: center;
  }

  .footer-actions :global(.socials img) {
    display: block;
  }

  @media (max-width: 480px) {
    .footer-inner {
      flex-direction: column;
      text-align: center;
      gap: 1.5rem;
    }

    .copyright {
      order: 1;
    }

    .footer-actions {
      order: 0;
      justify-content: center;
      align-items: center;
    }
  }
</style>
