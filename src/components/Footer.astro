---
import Socials from './Socials.astro'
import { getLocaleFromUrl, t } from '../i18n/utils'

const locale = getLocaleFromUrl(Astro.url)
const i = t(locale)
const currentYear = new Date().getFullYear();
---

<footer>
  <div class="footer-inner">
    <small class="copyright">&copy; {currentYear} {i.footer.copyright}</small>
    <Socials />
  </div>
</footer>

<style>
  footer {
    border-top: 1px solid var(--border);
    margin-top: 4rem;
  }

  .footer-inner {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem 2rem;
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .copyright {
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
</style>
