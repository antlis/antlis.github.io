---
import FoxLogo from './FoxLogo.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'
import { Toggle } from 'astro-theme-toggle/components'
import { getLocaleFromUrl, t, localePath } from '../i18n/utils'

const locale = getLocaleFromUrl(Astro.url)
const i = t(locale)

const navItems = [
  { label: i.nav.about, href: localePath('/about', locale) },
  { label: i.nav.blog, href: localePath('/blog', locale) },
  { label: i.nav.portfolio, href: localePath('/portfolio', locale) },
  { label: i.nav.contact, href: localePath('/contact', locale) },
]

const currentPath = Astro.url.pathname
---

<header transition:persist="header">
  <nav>
    <a href={localePath('/', locale)} class="logo" aria-label="Home">
      <FoxLogo size={48} />
    </a>

    <div class="nav-links">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={['nav-link', { active: currentPath === item.href }]}
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="nav-end">
      <LanguageSwitcher />
      <Toggle style="width: 24px; height: 24px;" />
      <button class="menu-toggle" aria-label="Toggle menu" aria-expanded="false">
        <span class="hamburger"></span>
      </button>
    </div>

    <div class="mobile-menu">
      <div class="mobile-links">
        {navItems.map(item => (
          <a
            href={item.href}
            class:list={['mobile-link', { active: currentPath === item.href }]}
          >
            {item.label}
          </a>
        ))}
      </div>
    </div>
  </nav>
</header>

<script>
  function updateActiveLink() {
    const path = window.location.pathname
    document.querySelectorAll('.nav-link, .mobile-link').forEach((link) => {
      const href = link.getAttribute('href')
      link.classList.toggle('active', href === path || (href !== '/' && path.startsWith(href)))
    })
  }

  function initMenu() {
    const toggle = document.querySelector('.menu-toggle')
    const mobileMenu = document.querySelector('.mobile-menu')
    if (!toggle || !mobileMenu) return

    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true'
      toggle.setAttribute('aria-expanded', String(!expanded))
      mobileMenu.classList.toggle('open')
    })

    mobileMenu.querySelectorAll('.mobile-link').forEach((link) => {
      link.addEventListener('click', () => {
        toggle.setAttribute('aria-expanded', 'false')
        mobileMenu.classList.remove('open')
      })
    })
  }

  updateActiveLink()
  initMenu()
  document.addEventListener('astro:after-swap', () => {
    updateActiveLink()
    initMenu()
  })
</script>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }

  nav {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover {
    color: var(--text);
  }

  .nav-link.active {
    color: var(--text);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .menu-toggle {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 0.5rem;
    margin: -0.5rem -0.5rem -0.5rem 0;
    z-index: 11;
  }

  .hamburger,
  .hamburger::before,
  .hamburger::after {
    display: block;
    width: 20px;
    height: 2px;
    background: var(--text);
    border-radius: 1px;
    transition: transform 0.3s, opacity 0.3s;
  }

  .hamburger {
    position: relative;
  }

  .hamburger::before,
  .hamburger::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .hamburger::before {
    top: -6px;
  }

  .hamburger::after {
    top: 6px;
  }

  .menu-toggle[aria-expanded='true'] .hamburger {
    background: transparent;
  }

  .menu-toggle[aria-expanded='true'] .hamburger::before {
    top: 0;
    transform: rotate(45deg);
  }

  .menu-toggle[aria-expanded='true'] .hamburger::after {
    top: 0;
    transform: rotate(-45deg);
  }

  .mobile-menu {
    display: none;
    max-height: 0;
    opacity: 0;
    transition: max-height 0.3s ease, opacity 0.3s ease;
  }

  @media (max-width: 640px) {
    nav {
      flex-wrap: wrap;
      padding: 1rem;
      justify-content: flex-start;
      gap: 0;
    }

    .nav-links {
      display: none;
    }

    .nav-end {
      display: flex;
      margin-left: auto;
      gap: 0.75rem;
      align-items: center;
    }

    .menu-toggle {
      display: flex;
      align-items: center;
    }

    .mobile-menu {
      display: block;
      width: 100%;
      padding-top: 0;
      max-height: 0;
      opacity: 0;
      transition: max-height 0.3s ease, opacity 0.3s ease, padding-top 0.3s ease;
    }

    .mobile-menu.open {
      max-height: 300px;
      opacity: 1;
      padding-top: 0.75rem;
    }

    .mobile-links {
      display: flex;
      flex-direction: column;
      margin: 0 -1rem -1rem;
      border-top: 1px solid var(--border);
    }

    .mobile-link {
      display: block;
      padding: 0.75rem 1rem;
      font-size: 1rem;
      font-weight: 500;
      color: var(--text-secondary);
      text-decoration: none;
      border-bottom: 1px solid var(--border);
      transition: color 0.2s;
    }

    .mobile-link:last-child {
      border-bottom: none;
    }

  .mobile-link:hover {
    color: var(--text);
  }

  .mobile-link.active {
    color: var(--text);
  }

  }
</style>
