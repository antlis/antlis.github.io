---
import FoxLogo from './FoxLogo.astro'
import LanguageSwitcher from './LanguageSwitcher.astro'
import { Toggle } from 'astro-theme-toggle/components'
import { getLocaleFromUrl, t, localePath } from '../i18n/utils'

const locale = getLocaleFromUrl(Astro.url)
const i = t(locale)

const navItems = [
  { label: i.nav.about, href: localePath('/about', locale) },
  { label: i.nav.blog, href: localePath('/blog', locale) },
  { label: i.nav.portfolio, href: localePath('/portfolio', locale) },
]

const currentPath = Astro.url.pathname
---

<header>
  <nav>
    <a href={localePath('/', locale)} class="logo" aria-label="Home">
      <FoxLogo size={48} />
    </a>

    <div class="nav-links">
      {navItems.map(item => (
        <a
          href={item.href}
          class:list={['nav-link', { active: currentPath === item.href }]}
        >
          {item.label}
        </a>
      ))}
    </div>

    <div class="nav-end">
      <LanguageSwitcher />
      <Toggle style="width: 24px; height: 24px;" />
    </div>
  </nav>
</header>

<style>
  header {
    border-bottom: 1px solid var(--border);
  }

  nav {
    max-width: 1400px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .logo {
    display: flex;
    align-items: center;
  }

  .nav-links {
    display: flex;
    gap: 2rem;
  }

  .nav-link {
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }

  .nav-link:hover,
  .nav-link.active {
    color: var(--text);
  }

  .nav-end {
    display: flex;
    align-items: center;
    gap: 1rem;
  }
</style>
